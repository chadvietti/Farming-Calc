            </div>
          </div>
        </div>
        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:"8px", marginBottom:"14px" }}>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Base price / berry $</label>
            <input type="number" value={species.basePrice}
              onChange={e => onUpdate({ ...species, basePrice: Number(e.target.value),
                marketPrice: String(Number(e.target.value) + 100) })} style={fs} />
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>
              Market price / berry $
              <span style={{ color:"#86efac", marginLeft:"6px" }}>
                → ${marketNet} via GTL{species.name === "Leppa" && ` · $${directNet} via direct trade`}
              </span>
            </label>
            <input type="number" value={mp}
              onChange={e => onUpdate({ ...species, marketPrice: e.target.value })}
              style={{ ...fs,
                background: mp !== species.basePrice + 100 ? "#0f2a0f" : "#1a1a2e",
                border:`1px solid ${mp !== species.basePrice + 100 ? "#2a6a2a" : "#2a2a4a"}`,
                color: mp !== species.basePrice + 100 ? "#86efac" : COL.text }} />
          </div>
        </div>
        <div style={{ fontSize:"11px", color:COL.muted, marginBottom:"8px" }}>Seeds per plot:</div>
        <div style={{ display:"flex", flexWrap:"wrap", gap:"8px" }}>
          {SEED_TYPES.map(seed => {
            const meta = SEED_FLAVOR[seed];
            const val  = species.seeds[seed] || 0;
            return (
              <div key={seed} style={{ display:"flex", flexDirection:"column", alignItems:"center", gap:"3px",
                background:val>0 ? meta.bg : "transparent", border:`1px solid ${val>0 ? meta.border : "#1e1e3f"}`,
                borderRadius:"6px", padding:"5px 7px", minWidth:"54px" }}>
                <label style={{ fontSize:"9px", color:val>0 ? meta.label : "#4a4a6a",
                  textAlign:"center", lineHeight:"1.3" }}>
                  {seed.split(" ")[0]}<br />{seed.split(" ")[1]}
                </label>
                <input type="number" min="0" value={val}
                  onChange={e => {
                    const n = Number(e.target.value);
                    const s = { ...species.seeds };
                    if (n===0) delete s[seed]; else s[seed]=n;
                    onUpdate({ ...species, seeds: s });
                  }}
                  style={{ background:"transparent", border:"none",
                    borderBottom:`1px solid ${val>0 ? meta.border : "#2a2a4a"}`,
                    color:val>0 ? meta.label : "#6a6a8a", width:"38px", fontSize:"13px", textAlign:"center" }} />
              </div>
            );
          })}
        </div>
      </div>
    );
  }

  // ── BerryRow ─────────────────────────────────────────────────────────────────
  // Raw ingredients (Berry Powder, Wings, Herbs, etc.) keep a cheap flat
  // threshold — they're a cost, not something being sold, so a full
  // statistical read isn't worth the fetch. See CRAFT_THIN_THRESHOLD usage
  // in CraftingCalculator's ingredient rows.
  const CRAFT_THIN_THRESHOLD = 500;

  // Berries and the tracked crafted items instead compare current listed
  // quantity against their own trailing-year average — sparse/flooded means
  // unusually low/high for THIS item, not vs. some arbitrary shared number.
  // Ratio bounds are multiplicatively symmetric (0.5× / 2.0×, i.e. half vs.
  // double), not additively (0.5/1.5) — halving and doubling are the same
  // "distance" in ratio terms, whereas 1.5 is a smaller move than 0.5. A
  // flooded market is also generally less risky for a seller than a thin
  // one, so a slightly more lenient upper bound is reasonable too.
  const LIQUIDITY_SPARSE_RATIO = 0.5;
  const LIQUIDITY_FLOODED_RATIO = 2.0;

  // Separate from the ratio check above: a market can be "normal" relative to
  // its own history and still be thin in absolute terms (e.g. always sits
  // around 800 listed) — flagged independently so a stable-but-thin market
  // doesn't get missed just because it isn't a historical anomaly.
  const LIQUIDITY_ABSOLUTE_FLOOR = 1000;

  // Raw-material price ratio (1yr avg), for timing purchases in the Crafting
  // Calculator. Symmetric with 0.8× the same way LIQUIDITY_* are above: the
  // reciprocal of 0.8 is 1.25, not 1.2 or 1.4 — a 20%-below move and a 25%-
  // above move are the "same distance" in ratio terms.
  const PRICE_CHEAP_RATIO = 0.8;
  const PRICE_EXPENSIVE_RATIO = 1.25;
  function liquidityFlag(currentQty, stats) {
    if (currentQty === undefined || !stats || !stats.avg) return null;
    const ratio = currentQty / stats.avg;
    const status = ratio <= LIQUIDITY_SPARSE_RATIO ? "sparse" : ratio >= LIQUIDITY_FLOODED_RATIO ? "flooded" : "normal";
    const lowAbsolute = currentQty < LIQUIDITY_ABSOLUTE_FLOOR;
    return { currentQty, avg: stats.avg, ratio, status, lowAbsolute };
  }

  function LiquidityCell({ liq }) {
    if (!liq) return <td style={{ padding:"9px 8px", textAlign:"right", color:"#4a4a6a", fontSize:"11px" }}>—</td>;
    const color = liq.status === "sparse" ? COL.red : liq.status === "flooded" ? COL.blue : COL.muted;
    const icon = liq.status === "sparse" ? "▼ " : liq.status === "flooded" ? "▲ " : "";
    return (
      <td style={{ padding:"9px 8px", textAlign:"right" }}>
        <div style={{ color, fontWeight:liq.status==="normal" ? "400" : "700", fontSize:"12px" }}>
          {icon}{fmt(liq.currentQty)}
          {liq.lowAbsolute && <span style={{ color:"#facc15", fontWeight:"700" }}> !</span>}
        </div>
        <div style={{ fontSize:"9px", color:"#4a4a6a" }}>
          avg/1yr {fmt(liq.avg)} ({liq.ratio.toFixed(2)}×)
          {liq.lowAbsolute && <span style={{ color:"#facc15" }}> · under {fmt(LIQUIDITY_ABSOLUTE_FLOOR)}</span>}
        </div>
      </td>
    );
  }

  function BerryRow({ m, isBest, pricingMode }) {
    const rowBg = isBest ? "#0a1a12" : "transparent";
    const showTradeLine = m.isLeppa && (pricingMode || "auto") === "auto";
    const liq = liquidityFlag(m.listedQuantity, m.liquidity);
    return (
      <tr style={{ background:rowBg, borderBottom:`1px solid ${COL.border}` }}>
        <td style={{ padding:"9px 8px", whiteSpace:"nowrap" }}>
          <div style={{ display:"flex", alignItems:"center", gap:"6px" }}>
            <span style={{ color:isBest ? COL.accent : COL.purple, fontWeight:isBest ? "700" : "400" }}>
              {isBest ? "★ " : ""}{m.name}
            </span>
          </div>
          {m.tag && (
            <span style={{ display:"inline-block", marginTop:"3px", fontSize:"9px",
              color: TAG_META[m.tag]?.color || COL.muted,
              background: TAG_META[m.tag]?.bg || "transparent",
              border: `1px solid ${TAG_META[m.tag]?.border || COL.border}`,
              borderRadius:"4px", padding:"1px 5px", whiteSpace:"nowrap" }}>
              {m.tag}
            </span>
          )}
        </td>
        <td style={{ padding:"9px 8px" }}>
          <div style={{ display:"flex", flexWrap:"wrap", gap:"3px" }}>
            {Object.keys(m.seeds).map(seed => <SeedChip key={seed} seed={seed} />)}
          </div>
        </td>
        <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted }}>${m.basePrice}</td>
        <td style={{ padding:"9px 8px", textAlign:"right" }}>
          {showTradeLine ? (
            <>
              <div style={{ color: m.mp !== m.basePrice + 100 ? "#86efac" : COL.muted, fontWeight:"600" }}>
                ${m.mp}
              </div>
              <div style={{ fontSize:"10px", color: m.sellChannel==="Trade" ? COL.accent : COL.muted }}>
                Trade ${fmt(m.tradeNet)}
              </div>
            </>
          ) : (
            <>
              <div style={{ color: m.mp !== m.basePrice + 100 ? "#86efac" : COL.muted, fontWeight:"600" }}>
                ${m.mp}
              </div>
              <div style={{ fontSize:"10px", color:m.sellChannel==="NPC" ? COL.gold : COL.muted }}>
                via {m.sellChannel}
              </div>
            </>
          )}
        </td>
        <LiquidityCell liq={liq} />
        <td style={{ padding:"9px 8px", textAlign:"right" }}>
          {showTradeLine ? (
            <>
              <div>${fmt(m.gtl.revenue)} <span style={{ fontSize:"9px", color:COL.muted }}>GTL</span></div>
              <div>${fmt(m.trade.revenue)} <span style={{ fontSize:"9px", color:COL.muted }}>Trade</span></div>
            </>
          ) : (
            <>${fmt(m.revenue)}</>
          )}
        </td>
        <td style={{ padding:"9px 8px", textAlign:"right", color:COL.red }}>${fmt(m.seedCost)}</td>
        <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted }}>
          {showTradeLine ? (
            <>
              <div>{m.gtl.margin.toFixed(1)}% <span style={{ fontSize:"9px" }}>GTL</span></div>
              <div>{m.trade.margin.toFixed(1)}% <span style={{ fontSize:"9px" }}>Trade</span></div>
            </>
          ) : (
            <>{m.margin.toFixed(1)}%</>
          )}
        </td>
        <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted, whiteSpace:"nowrap" }}>
          <div>{m.growHours}h ({m.theorDays % 1 === 0 ? m.theorDays : m.theorDays.toFixed(2)}d)</div>
          <div style={{ fontSize:"10px", color:m.waitPenalty ? COL.gold : "#4a4a6a" }}>
            every {m.practicalDays}d{m.waitPenalty ? " ⚠" : ""}
          </div>
        </td>
        <td style={{ padding:"9px 8px", textAlign:"right",
          color:isBest ? COL.gold : COL.text, fontWeight:isBest ? "700" : "400" }}>
          {showTradeLine ? (
            <>
              <div>${fmt(m.gtl.netPerDay)} <span style={{ fontSize:"9px", fontWeight:"400", color:COL.muted }}>GTL</span></div>
              <div>${fmt(m.trade.netPerDay)} <span style={{ fontSize:"9px", fontWeight:"400", color:COL.muted }}>Trade</span></div>
            </>
          ) : (
            <>${fmt(m.netPerDay)}</>
          )}
          {m.cyclesPerDay !== 1 && (
            <div style={{ fontSize:"10px", color:COL.gold }}>
              {m.cyclesPerDay % 1 === 0 ? m.cyclesPerDay : m.cyclesPerDay.toFixed(2)}× cycles
            </div>
          )}
        </td>
      </tr>
    );
  }

  // ── BerryTable ────────────────────────────────────────────────────────────────
  const TABLE_HEADERS = ["Berry","Seeds Required","Base $","Market $","Liquidity","Revenue","Seed Cost","Margin","Grow / Harvest","Net/Day"];
  function BerryTable({ rows, bestId, pricingMode }) {
    return (
      <div style={{ overflowX:"auto" }}>
        <table style={{ width:"100%", borderCollapse:"collapse", fontSize:"12px", minWidth:"780px" }}>
          <thead>
            <tr style={{ color:COL.muted, borderBottom:`1px solid ${COL.border}` }}>
              {TABLE_HEADERS.map(h => (
                <th key={h} style={{ padding:"7px 8px",
                  textAlign:h==="Berry"||h==="Seeds Required" ? "left" : "right",
                  fontWeight:"400", whiteSpace:"nowrap" }}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((m, i) => (
              <BerryRow key={m.id} m={m} isBest={m.id === bestId} pricingMode={pricingMode} />
            ))}
          </tbody>
        </table>
      </div>
    );
  }

  // ── SeedCracker ───────────────────────────────────────────────────────────────
  // Only these 5 berries are ever cracked — cheapest to grow/buy, and every
  // berry in the game yields exactly 1 seed per Harvest Tool use, of that
  // berry's own flavor (2/7 Very, 5/7 Plain — fixed game odds, not editable).
  const CRACKABLE_BERRIES = ["Rawst", "Pecha", "Cheri", "Aspear", "Chesto"];
  const VERY_PROB = 2 / 7, PLAIN_PROB = 5 / 7;
  const CRACK_TOOL_COST = 350;

  function crackSeedKeys(sp) {
    const keys = Object.keys(sp.seeds);
    return {
      veryKey:  keys.find(k => k.startsWith("Very ")),
      plainKey: keys.find(k => k.startsWith("Plain ")),
    };
  }

  // Shared by SeedCracker's "Grow vs. Crack" panel and the Berry Optimizer —
  // net/day if you grow this berry, crack every harvest, and sell the seeds.
  // Returns null for berries that can't be cracked (not one of the 5).
  function crackNetPerDayForBerry(sp, seedPrices, listingFeeOn) {
    if (!sp || !CRACKABLE_BERRIES.includes(sp.name)) return null;
    const { veryKey, plainKey } = crackSeedKeys(sp);
    const seedNet = (seedName) => {
      const p = seedPrices[seedName] || 0;
      return Math.max(0, p - (listingFeeOn ? listingFee(p) : 0));
    };
    const berryYield = sp.berriesPerTree * PLOTS;
    const toolTotal = berryYield * CRACK_TOOL_COST;
    const seedRev = berryYield * VERY_PROB * seedNet(veryKey) + berryYield * PLAIN_PROB * seedNet(plainKey);
    const netProfit = seedRev - toolTotal - sp.seedCost;
    return netProfit * sp.cyclesPerDay;
  }

  function SeedCracker({ seedPrices, metrics }) {
    const crackable = metrics.filter(m => CRACKABLE_BERRIES.includes(m.name));
    const [selectedId,   setSelectedId]   = useState(crackable[0]?.id ?? null);
    const [quantity,     setQuantity]     = useState(700);
    const [costMode,     setCostMode]     = useState("GTL"); // "NPC" | "GTL"
    const [listingFeeOn, setListingFeeOn] = useState(true);

    const sp = crackable.find(s => s.id === selectedId) || crackable[0] || null;
    const { veryKey, plainKey } = sp ? crackSeedKeys(sp) : {};

    const seedNet = (seedName) => {
      const p = seedPrices[seedName] || 0;
      return Math.max(0, p - (listingFeeOn ? listingFee(p) : 0));
    };

    const berryCost = sp ? (costMode === "NPC" ? sp.basePrice : sp.mp) : 0;

    // ── Crack Profitability: buy `quantity` berries, crack them all ──
    const crack = useMemo(() => {
      if (!sp) return null;
      const veryNet = seedNet(veryKey), plainNet = seedNet(plainKey);
      const veryQty = quantity * VERY_PROB, plainQty = quantity * PLAIN_PROB;
      const toolTotal  = quantity * CRACK_TOOL_COST;
      const berryTotal = quantity * berryCost;
      const seedRev = veryQty * veryNet + plainQty * plainNet;
      return { veryNet, plainNet, veryQty, plainQty, toolTotal, berryTotal, seedRev,
        netProfit: seedRev - toolTotal - berryTotal };
    }, [sp, veryKey, plainKey, quantity, berryCost, seedPrices, listingFeeOn]);

    // ── Grow vs. Crack: grow it yourself, then sell berries or crack+sell seeds ──
    const growVsCrack = useMemo(() => {
      if (!sp) return null;
      return {
        berryYield: sp.berriesPerTree * PLOTS,
        sellNetPerDay:  sp.netPerDay,
        crackNetPerDay: crackNetPerDayForBerry(sp, seedPrices, listingFeeOn),
      };
    }, [sp, seedPrices, listingFeeOn]);

    if (!sp) return null;

    return (
      <div style={{ background:COL.card, border:"1px solid #2a1a4a", borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
        <div style={{ fontSize:"11px", color:COL.purple, letterSpacing:"2px", textTransform:"uppercase", marginBottom:"16px" }}>
          🔨 Seed Cracker — Berry → Seed Profitability
        </div>

        {/* Top inputs row */}
        <div style={{ display:"grid", gridTemplateColumns:"1.5fr 1fr 1fr", gap:"10px", marginBottom:"16px" }}>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Berry to crack</label>
            <select value={selectedId || ""}
              onChange={e => setSelectedId(Number(e.target.value))}
              style={{ ...fs, cursor:"pointer" }}>
              {crackable.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
            </select>
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Input cost basis</label>
            <select value={costMode} onChange={e => setCostMode(e.target.value)}
              style={{ ...fs, cursor:"pointer" }}>
              <option value="GTL">GTL price (${fmt(sp.mp)})</option>
              <option value="NPC">NPC price (${fmt(sp.basePrice)})</option>
            </select>
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Quantity to crack</label>
            <input type="number" value={quantity}
              onChange={e => setQuantity(Number(e.target.value))} style={fs} />
          </div>
        </div>

        <div style={{ display:"flex", gap:"16px", marginBottom:"18px", fontSize:"11px", color:COL.muted,
          background:"#0d0d1f", borderRadius:"6px", padding:"8px 12px", flexWrap:"wrap" }}>
          <span>Odds: <span style={{ color:"#86efac" }}>2/7 {veryKey}</span>,
            <span style={{ color:"#86efac" }}> 5/7 {plainKey}</span> (fixed, per Harvest Tool)</span>
          <label style={{ display:"flex", alignItems:"center", gap:"6px", cursor:"pointer" }}>
            <input type="checkbox" checked={listingFeeOn} onChange={e => setListingFeeOn(e.target.checked)}
              style={{ accentColor:COL.accent, width:"14px", height:"14px" }} />
            Apply GTL listing fee to seed sales
          </label>
        </div>

        {/* ── Part 1: Crack Profitability ── */}
        <div style={{ fontSize:"11px", color:"#7dd3fc", letterSpacing:"1px", textTransform:"uppercase", marginBottom:"10px" }}>
          Buy & Crack ({fmt(quantity)} berries via {costMode})
        </div>
        <div style={{ display:"grid", gridTemplateColumns:"repeat(4,1fr)", gap:"8px", marginBottom:"10px" }}>
          {[
            { label:"Berry cost",   value:`-$${fmt(crack.berryTotal)}`, color:COL.red },
            { label:"Tool cost",    value:`-$${fmt(crack.toolTotal)}`,  color:COL.red },
            { label:"Seed revenue", value:`$${fmt(crack.seedRev)}`,     color:COL.accent,
              sub:`${fmt(crack.veryQty)}×Very @ $${fmt(crack.veryNet)} · ${fmt(crack.plainQty)}×Plain @ $${fmt(crack.plainNet)}` },
            { label:"Net profit",   value:`${crack.netProfit>=0?"+":""}$${fmt(crack.netProfit)}`,
              color: crack.netProfit>=0 ? COL.accent : COL.red },
          ].map(({ label, value, color, sub }) => (
            <div key={label} style={{ background:"#0d0d1f", borderRadius:"6px", padding:"9px 10px" }}>
              <div style={{ fontSize:"10px", color:COL.muted, marginBottom:"3px" }}>{label}</div>
              <div style={{ fontSize:"13px", fontWeight:"600", color }}>{value}</div>
              {sub && <div style={{ fontSize:"9px", color:"#4a4a6a", marginTop:"2px" }}>{sub}</div>}
            </div>
          ))}
        </div>
        <div style={{ fontSize:"11px", color: crack.netProfit>=0 ? "#4ade80" : COL.muted, marginBottom:"20px" }}>
          {crack.netProfit>=0
            ? "✓ Profitable to buy and crack right now"
            : "✗ Not profitable to buy and crack right now (usually the case — small chance it flips)"}
        </div>

        {/* ── Part 2: Grow vs. Crack ── */}
        <div style={{ fontSize:"11px", color:"#7dd3fc", letterSpacing:"1px", textTransform:"uppercase",
          borderTop:"1px solid #2a2a4a", paddingTop:"16px", marginBottom:"10px" }}>
          Grow It Yourself: Sell Berries vs. Crack & Sell Seeds (per day, {PLOTS} plots)
        </div>
        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:"10px" }}>
          {[
            { label:"Sell berries",         sub:`via ${sp.sellChannel}`, val:growVsCrack.sellNetPerDay,
              win: growVsCrack.sellNetPerDay >= growVsCrack.crackNetPerDay },
            { label:"Crack & sell seeds",   sub:`${fmt(growVsCrack.berryYield)} berries → seeds`, val:growVsCrack.crackNetPerDay,
              win: growVsCrack.crackNetPerDay > growVsCrack.sellNetPerDay },
          ].map(({ label, sub, val, win }) => (
            <div key={label} style={{ background:win ? "#0a1a0a" : "#0d0d1f",
              border:`1px solid ${win ? "#1a4a1a" : COL.border}`, borderRadius:"8px", padding:"12px" }}>
              <div style={{ fontSize:"11px", color:win ? COL.accent : COL.muted, marginBottom:"2px" }}>
                {win ? "★ " : ""}{label}
              </div>
              <div style={{ fontSize:"10px", color:"#4a4a6a", marginBottom:"8px" }}>{sub}</div>
              <div style={{ fontSize:"20px", fontWeight:"700", color:win ? COL.gold : COL.text }}>
                ${fmt(val)}<span style={{ fontSize:"11px", fontWeight:"400", color:COL.muted }}> /day</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }

  // ── CraftingCalculator ──────────────────────────────────────────────────────────
  // Any berry crushes into 1 Berry Powder at 0 cost, so individual berry market
  // prices don't matter here — only the max $/powder a recipe can afford to pay
  // and still profit. Only the 3-day berries are considered for growing (highest
  // yield/plot). Recipes and defaults sourced from the guide's own "Berry Powder
  // Farming" section where available (PP Max, vitamins, Max Ether/Elixir tiers);
  // status cures/Ether/Elixir/PP Up have no guide default, left at $0 to fill in.
  const THREE_DAY_BERRIES = ["Liechi", "Ganlon", "Salac", "Petaya", "Apicot"];

  const CRAFT_INGREDIENT_DEFAULTS = {
    "Fresh Water": 0, "Energy Root": 2700, "Revival Herb": 2900,
    "Health Wing": 800, "Muscle Wing": 800, "Resist Wing": 800,
    "Genius Wing": 800, "Clever Wing": 800, "Swift Wing": 800, "White Herb": 900,
    // "Heal Powder"/"Energy Powder" deliberately absent — they're a direct-buy
    // fallback only populated by live sync; ingredientUnitCost treats missing
    // as Infinity so the crafted-from-Lum/Energy-Root cost wins until synced.
  };

  const CRAFT_ITEM_PRICE_DEFAULTS = {
    "Full Heal": 1750, "Max Potion": 2600, "Full Restore": 3500, "Max Revive": 7000,
    "Ether": 0, "Max Ether": 12000, "Elixir": 0, "Max Elixir": 24000,
    "HP Up": 2000, "Protein": 2000, "Iron": 2000, "Calcium": 2000, "Zinc": 2000, "Carbos": 3100, "PP Up": 0,
    "Hyper HP Up": 3000, "Hyper Protein": 7400, "Hyper Iron": 2300,
    "Hyper Calcium": 6300, "Hyper Zinc": 2500, "Hyper Carbos": 13500, "PP Max": 18100,
  };

  // Berry-ingredient names → tracked species name, for live/best-price lookup
  const CRAFT_BERRY_SOURCE = {
    "Pecha Berry": "Pecha", "Rawst Berry": "Rawst", "Aspear Berry": "Aspear",
    "Chesto Berry": "Chesto", "Cheri Berry": "Cheri", "Leppa Berry": "Leppa",
  };

  const CRAFTING_RECIPES = [
    // Status Cures (Berry Juice/Antidote/Burn Heal/Ice Heal/Awakening/Parlyz Heal)
    // removed entirely — consistently negative profitability, not worth modeling.
    { name:"Full Heal",     category:"Restores",     bp:6,  ingredients:[{name:"Heal Powder",  qty:2}] },
    { name:"Max Potion",    category:"Restores",     bp:8,  ingredients:[{name:"Energy Powder",qty:2}] },
    { name:"Full Restore",  category:"Restores",     bp:12, ingredients:[{name:"Heal Powder",  qty:3},{name:"Energy Powder",qty:2}] },
    { name:"Max Revive",    category:"Restores",     bp:14, ingredients:[{name:"Heal Powder",  qty:2},{name:"Revival Herb",qty:1}] },
    { name:"Ether",         category:"Ethers",       bp:3,  ingredients:[{name:"Leppa Berry",  qty:1}] },
    { name:"Max Ether",     category:"Ethers",       bp:8,  ingredients:[{name:"Leppa Berry",  qty:3}] },
    { name:"Elixir",        category:"Ethers",       bp:8,  ingredients:[{name:"Leppa Berry",  qty:3}] },
    { name:"Max Elixir",    category:"Ethers",       bp:16, ingredients:[{name:"Leppa Berry",  qty:8}] },
    { name:"HP Up",         category:"Vitamins",     bp:3,  ingredients:[{name:"Health Wing",  qty:1}] },
    { name:"Protein",       category:"Vitamins",     bp:3,  ingredients:[{name:"Muscle Wing",  qty:1}] },
    { name:"Iron",          category:"Vitamins",     bp:3,  ingredients:[{name:"Resist Wing",  qty:1}] },
    { name:"Calcium",       category:"Vitamins",     bp:3,  ingredients:[{name:"Genius Wing",  qty:1}] },
    { name:"Zinc",          category:"Vitamins",     bp:3,  ingredients:[{name:"Clever Wing",  qty:1}] },
    { name:"Carbos",        category:"Vitamins",     bp:3,  ingredients:[{name:"Swift Wing",   qty:1}] },
    { name:"PP Up",         category:"Vitamins",     bp:9,  ingredients:[{name:"White Herb",   qty:1}] },
    { name:"Hyper HP Up",   category:"Hyper Vitamins", bp:14, ingredients:[{name:"Health Wing", qty:5}] },
    { name:"Hyper Protein", category:"Hyper Vitamins", bp:14, ingredients:[{name:"Muscle Wing", qty:5}] },
    { name:"Hyper Iron",    category:"Hyper Vitamins", bp:14, ingredients:[{name:"Resist Wing", qty:5}] },
    { name:"Hyper Calcium", category:"Hyper Vitamins", bp:14, ingredients:[{name:"Genius Wing", qty:5}] },
    { name:"Hyper Zinc",    category:"Hyper Vitamins", bp:14, ingredients:[{name:"Clever Wing", qty:5}] },
    { name:"Hyper Carbos",  category:"Hyper Vitamins", bp:14, ingredients:[{name:"Swift Wing",  qty:5}] },
    { name:"PP Max",        category:"Hyper Vitamins", bp:24, ingredients:[{name:"White Herb",  qty:3}] },
  ];

  function ingredientUnitCost(name, metricsByName, ingredientPrices, derivedSource) {
    // Heal Powder and Energy Powder are both craftable AND directly tradeable —
    // caller picks which explicitly (derivedSource), not an auto-pick-cheapest.
    // Berry-type ingredients (Leppa Berry, etc.) always cost GTL price — NOT
    // NPC, even when NPC happens to be cheaper. Per the user: NPC vendor price
    // is what they pay YOU for selling to them, not a real buy-in option, so
    // silently picking min(NPC, GTL) understated Max Ether/Elixir's real cost.
    if (name === "Heal Powder") {
      if (derivedSource?.["Heal Powder"] === "direct") return ingredientPrices["Heal Powder"] || 0;
      const lum = metricsByName["Lum"];
      return lum ? lum.mp / 2 : 0; // 1 Lum Berry → 2 Heal Powder
    }
    if (name === "Energy Powder") {
      if (derivedSource?.["Energy Powder"] === "direct") return ingredientPrices["Energy Powder"] || 0;
      return (ingredientPrices["Energy Root"] || 0) / 4; // 1 Energy Root → 4 Energy Powder
    }
    const berrySpecies = CRAFT_BERRY_SOURCE[name];
    if (berrySpecies) {
      const sp = metricsByName[berrySpecies];
      return sp ? sp.mp : 0;
    }
    return ingredientPrices[name] || 0;
  }

  // Shared by the Crafting Calculator's "Show Most Profitable" button and the
  // Berry Optimizer — best (recipe, netPerDay) if this berry is grown and every
  // harvested berry is crushed into Berry Powder for that recipe. Null if this
  // berry isn't one of the 5 three-day berries (the only ones worth growing for it).
  function bestCraftOptionForBerry(berryName, metricsByName, ingredientPrices, craftItemPrices, derivedSource) {
    if (!THREE_DAY_BERRIES.includes(berryName)) return null;
    const sp = metricsByName[berryName];
    if (!sp) return null;
    const powderYield = sp.berriesPerTree * PLOTS;
    let best = null;
    for (const recipe of CRAFTING_RECIPES) {
      const sellPrice = craftItemPrices[recipe.name] || 0;
      const sellNet = sellPrice - listingFee(sellPrice); // GTL only — no in-person "Direct" for crafted items
      const ingredientCostPerCraft = recipe.ingredients.reduce((sum, ing) =>
        sum + ing.qty * ingredientUnitCost(ing.name, metricsByName, ingredientPrices, derivedSource), 0);
      const craftsPerHarvest = powderYield / recipe.bp;
      const netProfit = craftsPerHarvest * sellNet - craftsPerHarvest * ingredientCostPerCraft - sp.seedCost;
      const netPerDay = netProfit * sp.cyclesPerDay;
      if (!best || netPerDay > best.netPerDay) best = { recipeName: recipe.name, netPerDay };
    }
    return best;
  }

  function DerivedIngredientInput({ ing, ingredientPrices, setIngredientPrices, derivedSource, setDerivedSource, unitCost, craftLabel }) {
    const mode = derivedSource[ing.name];
    return (
      <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
        <label style={{ fontSize:"11px", color:COL.muted }}>{ing.name} $</label>
        <select value={mode} onChange={e => setDerivedSource(p => ({ ...p, [ing.name]: e.target.value }))}
          style={{ ...fs, fontSize:"11px", cursor:"pointer", marginBottom:"3px" }}>
          <option value="craft">{craftLabel}</option>
          <option value="direct">Buy directly (GTL)</option>
        </select>
        {mode === "direct" ? (
          <input type="number" value={ingredientPrices[ing.name] || 0}
            onChange={e => setIngredientPrices(p => ({ ...p, [ing.name]: Number(e.target.value) }))}
            style={fs} />
        ) : (
          <div style={{ ...fs, background:"#0f1a0f", border:"1px solid #1a4a1a", color:"#86efac", display:"flex", alignItems:"center" }}>
            ${unitCost.toFixed(1)} <span style={{ fontSize:"9px", color:"#4a4a6a", marginLeft:"6px" }}>resolved</span>
          </div>
        )}
      </div>
    );
  }

  // ── BerryOptimizer ───────────────────────────────────────────────────────────
  // For one chosen berry: what's the best thing to do with it? Compares selling
  // to NPC, selling on GTL, converting to Berry Powder for crafting (3-day
  // berries only), and cracking for seeds (the 5 crackable berries only).
  // NPC keeps priority over GTL unless GTL beats it by more than 5% — per the
  // user, GTL sale isn't reliably better just because the sticker price is a
  // little higher; NPC is instant/guaranteed.
  const NPC_PRIORITY_MARGIN = 1.05;

  // Lum is a special case: 1 Lum Berry → 2 Heal Powder at 0 cost (same free-
  // conversion rule as Berry Powder, just a different output). This values
  // that conversion by selling the Heal Powder on GTL at its own tracked
  // price (full listing fee — Heal Powder isn't traded in person like Leppa
  // or seeds are) — NOT by chaining into Full Heal/Restore/Revive, since those
  // also need Berry Powder from a second berry, which re-introduces the
  // multi-berry "self-sustaining loop" the user already rejected as overly
  // complicated and plot-inefficient. (That fuller chain is still reachable
  // manually via the Crafting Calculator's "Craft (Lum Berry ×2)" toggle.)
  function healPowderNetPerDayForLum(sp, healPowderPrice) {
    if (sp.name !== "Lum" || !healPowderPrice) return null;
    const healPowderYield = sp.berriesPerTree * PLOTS * 2;
    const sellNet = healPowderPrice - listingFee(healPowderPrice);
    const netProfit = healPowderYield * sellNet - sp.seedCost;
    return netProfit * sp.cyclesPerDay;
  }

  function BerryOptimizer({ metrics, seedPrices, craftIngredientPrices, craftItemPrices }) {
    const metricsByName = useMemo(() => {
      const m = {};
      metrics.forEach(x => { m[x.name] = x; });
      return m;
    }, [metrics]);

    const [selectedId, setSelectedId] = useState(metrics[0]?.id ?? null);
    const sp = metrics.find(m => m.id === selectedId) || metrics[0];
    if (!sp) return null;

    const berryYield = sp.berriesPerTree * PLOTS;
    const npcNetPerDay = (berryYield * sp.npcNet - sp.seedCost) * sp.cyclesPerDay;
    const gtlNetPerDay = (berryYield * sp.marketNet - sp.seedCost) * sp.cyclesPerDay;
    const tradeNetPerDay = sp.isLeppa ? (berryYield * sp.tradeNet - sp.seedCost) * sp.cyclesPerDay : null;
    const craftOpt = bestCraftOptionForBerry(sp.name, metricsByName, craftIngredientPrices, craftItemPrices,
      { "Heal Powder":"craft", "Energy Powder":"craft" });
    const crackNetPerDay = crackNetPerDayForBerry(sp, seedPrices, true);
    const healPowderNetPerDay = healPowderNetPerDayForLum(sp, craftIngredientPrices["Heal Powder"]);

    const options = [
      { key:"NPC",    label:"Sell to NPC",  sub:`$${fmt(sp.npcNet)}/berry, no fee`,          netPerDay:npcNetPerDay },
      { key:"Market", label:"Sell on GTL",  sub:`$${fmt(sp.marketNet)}/berry after fee`,      netPerDay:gtlNetPerDay },
    ];
    if (tradeNetPerDay !== null) options.push({ key:"Trade", label:"Sell via Trade", sub:`$${fmt(sp.tradeNet)}/berry, in-person`, netPerDay:tradeNetPerDay });
    if (craftOpt) options.push({ key:"Craft", label:"Convert to Berry Powder", sub:`Best: ${craftOpt.recipeName}`, netPerDay:craftOpt.netPerDay });
    if (crackNetPerDay !== null) options.push({ key:"Crack", label:"Crack for seeds", sub:"Harvest Tool, 1 seed/berry", netPerDay:crackNetPerDay });
    if (healPowderNetPerDay !== null) options.push({ key:"HealPowder", label:"Convert to Heal Powder", sub:"2 per berry, free — sell direct", netPerDay:healPowderNetPerDay });

    const npc = options.find(o => o.key === "NPC");
    let recommended = options.reduce((a, b) => b.netPerDay > a.netPerDay ? b : a);
    // NPC's instant, no-hassle sale keeps priority unless GTL or Trade clears it by a real margin
    if ((recommended.key === "Market" || recommended.key === "Trade") &&
        recommended.netPerDay <= npc.netPerDay * NPC_PRIORITY_MARGIN) recommended = npc;

    return (
      <div style={{ background:COL.card, border:`1px solid ${COL.border}`, borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
        <div style={{ fontSize:"11px", color:COL.accent, letterSpacing:"2px", textTransform:"uppercase", marginBottom:"4px" }}>
          🎯 Berry Optimizer — What Should I Do With This Berry?
        </div>
        <div style={{ fontSize:"11px", color:"#4a4a6a", marginBottom:"14px" }}>
          NPC keeps priority unless GTL beats it by more than 5% — a GTL sale that's only marginally
