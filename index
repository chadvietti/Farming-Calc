                ))}
              </tr>
            </thead>
            <tbody>
              {Object.keys(RAW_MATERIAL_ITEM_IDS).map(id => RAW_MATERIAL_ITEM_IDS[id]).map(name => {
                const current = ingredientPrices[name];
                const stats = rawMaterialPriceHistory[name];
                if (current === undefined || !stats) return (
                  <tr key={name} style={{ borderBottom:`1px solid ${COL.border}` }}>
                    <td style={{ padding:"9px 8px", color:COL.purple }}>{name}</td>
                    <td colSpan={4} style={{ padding:"9px 8px", textAlign:"right", color:"#4a4a6a" }}>no data yet</td>
                  </tr>
                );
                const ratio = current / stats.avg;
                const status = ratio <= PRICE_CHEAP_RATIO ? "cheap" : ratio >= PRICE_EXPENSIVE_RATIO ? "expensive" : "normal";
                const color = status === "cheap" ? COL.accent : status === "expensive" ? COL.red : COL.text;
                const signal = status === "cheap" ? "✓ Good time to buy" : status === "expensive" ? "✗ Expensive — hold off" : "— Normal range";
                return (
                  <tr key={name} style={{ borderBottom:`1px solid ${COL.border}` }}>
