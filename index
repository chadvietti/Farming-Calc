                border:`1px solid ${waitPenalty ? "#5a5a00" : "#2a2a4a"}` }} />
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Cycles / day</label>
            <div style={{ background:"#0a1a0a", border:"1px solid #1a4a1a", borderRadius:"4px",
              color:COL.accent, padding:"5px 8px", fontSize:"13px" }}>
