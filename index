  // Market Watch — a general, user-extensible investment-tracking list, separate
  // from BP shop items (these aren't BP-redeemable, just collector/event items
  // the user wants price history on). Offset 0, same convention as everything
  // non-berry — verified live against the current Fiereu snapshot before adding.
  const MARKET_WATCH_ITEM_IDS = {
    1592: "Mysterious Poké Ball",
    1576: "Mysterious Poké Ball (2024)",
    1581: "Blank Wish Tag",
    1499: "Dream Essence",
  };

  async function fetchLivePrices() {
    const res = await fetch(LIVE_PRICE_API_URL, { cache: "no-store" });
    if (!res.ok) throw new Error(`Price API fetch failed (HTTP ${res.status})`);
    const items = await res.json();
    const seedPrices = {}, berryPrices = {}, berryQuantities = {};
    const craftIngredientPrices = {}, craftIngredientQuantities = {}, craftItemPrices = {}, craftItemQuantities = {};
    const bpItemPrices = {}, bpItemQuantities = {};
    const marketWatchPrices = {}, marketWatchQuantities = {};
    items.forEach(item => {
      const seedKey = SEED_ITEM_IDS[item.item_id];
      const berryKey = BERRY_ITEM_IDS[item.item_id];
      const ingredientKey = CRAFT_INGREDIENT_ITEM_IDS[item.item_id];
      const outputKey = CRAFT_OUTPUT_ITEM_IDS[item.item_id];
