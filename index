      if (berryKey && Number.isFinite(item.price)) {
        berryPrices[berryKey] = item.price;
        berryQuantities[berryKey] = item.quantity; // total units currently listed — a thin market skews "market price"
      }
      if (ingredientKey && Number.isFinite(item.price)) {
        craftIngredientPrices[ingredientKey] = item.price;
        craftIngredientQuantities[ingredientKey] = item.quantity;
      }
      if (outputKey && Number.isFinite(item.price)) {
        craftItemPrices[outputKey] = item.price;
        craftItemQuantities[outputKey] = item.quantity;
      }
      if (bpKey && Number.isFinite(item.price)) {
        bpItemPrices[bpKey] = item.price;
        bpItemQuantities[bpKey] = item.quantity;
      }
      if (watchKey && Number.isFinite(item.price)) {
        marketWatchPrices[watchKey] = item.price;
        marketWatchQuantities[watchKey] = item.quantity;
      }
    });
    if ([seedPrices, berryPrices, craftIngredientPrices, craftItemPrices].every(o => Object.keys(o).length === 0))
      throw new Error("No prices found in response");
    return { seedPrices, berryPrices, berryQuantities, bpItemPrices, bpItemQuantities,
      craftIngredientPrices, craftIngredientQuantities, craftItemPrices, craftItemQuantities,
      marketWatchPrices, marketWatchQuantities };
  }

  // ── Historical liquidity — mean + std dev over the trailing year ────────────
  // The /items snapshot's `quantity` is a single instant — not enough to tell
  // "thin right now" from "always this size." This pulls the /graph/.../quantity
  // series and computes mean + std dev over the trailing year, so a "thin market"
  // flag can mean "unusually low right now vs. this item's own normal," not an
  // arbitrary fixed cutoff. Note: the API ignores range/days/period query params
  // (confirmed by testing) — there's no way to ask the server for a shorter
  // window, so the full ~4-year, ~6000-point history downloads every time
  // regardless; we just only use the last LIQUIDITY_WINDOW_DAYS of it client-side.
  const LIQUIDITY_WINDOW_DAYS = 365;

  // Tukey's-fences outlier trim (1.5× IQR) — a single manipulated listing (someone
  // buying out a thin item and relisting at an absurd price to spike its perceived
  // value, or dumping a huge quantity for a day) can otherwise drag a plain mean
  // way off the item's real normal range. Caught live: Absorb Bulb sits flat at
  // ~$100-110 on GTL, but its naive 1yr average came out at $25,772 from one spike.
  function quantileOf(sortedValues, q) {
    const pos = (sortedValues.length - 1) * q;
    const base = Math.floor(pos);
    const rest = pos - base;
    return sortedValues[base + 1] !== undefined
      ? sortedValues[base] + rest * (sortedValues[base + 1] - sortedValues[base])
      : sortedValues[base];
  }
  function trimOutliers(values) {
    if (values.length < 4) return values; // too few points for quartiles to mean anything
    const sorted = [...values].sort((a, b) => a - b);
    const q1 = quantileOf(sorted, 0.25);
    const q3 = quantileOf(sorted, 0.75);
    const iqr = q3 - q1;
    const lower = q1 - 1.5 * iqr;
    const upper = q3 + 1.5 * iqr;
    const filtered = values.filter(v => v >= lower && v <= upper);
    return filtered.length > 0 ? filtered : values; // never trim everything away
  }

  // `metric` is "quantity" (liquidity) or "min" (price) — same graph endpoint shape either way.
  // Outlier trimming applies to every rolling average in the app (berries, crafting
  // items, raw materials, BP shop items) since they all funnel through this one function.
  // `windowDays` defaults to the 1yr window; a shorter window is used separately
  // for a robust "current price" (see RECENT_PRICE_WINDOW_DAYS below).
  async function fetchHistoryStats(itemIdMap, metric, windowDays = LIQUIDITY_WINDOW_DAYS) {
    const cutoff = Date.now() / 1000 - windowDays * 24 * 60 * 60;
    const entries = Object.entries(itemIdMap);
    const results = await Promise.all(entries.map(async ([itemId, name]) => {
      try {
        const res = await fetch(`https://apis.fiereu.de/pokemmoprices/v1/graph/items/${itemId}/${metric}`, { cache: "no-store" });
        if (!res.ok) return [name, null];
        const points = await res.json();
        const recent = points.filter(p => p.x >= cutoff).map(p => p.y);
        if (recent.length === 0) return [name, null];
        const trimmed = trimOutliers(recent);
        const avg = trimmed.reduce((s, y) => s + y, 0) / trimmed.length;
        const variance = trimmed.reduce((s, y) => s + (y - avg) ** 2, 0) / trimmed.length;
        const sorted = [...recent].sort((a, b) => a - b);
        return [name, { avg, stdDev: Math.sqrt(variance),
          median: quantileOf(sorted, 0.5), outliersTrimmed: recent.length - trimmed.length }];
      } catch {
        return [name, null];
      }
    }));
    const stats = {};
    results.forEach(([name, s]) => { if (s) stats[name] = s; });
    return stats;
  }
  const fetchLiquidityHistory = (itemIdMap) => fetchHistoryStats(itemIdMap, "quantity");
  const fetchPriceHistory     = (itemIdMap) => fetchHistoryStats(itemIdMap, "min");
  const fetchBerryLiquidityHistory = () => fetchLiquidityHistory(BERRY_ITEM_IDS);
  const fetchCraftLiquidityHistory = () => fetchLiquidityHistory(CRAFT_LIQUIDITY_ITEM_IDS);

  // A single live snapshot price can be a manipulated/thin-market outlier (caught
  // live: Petaya's snapshot read $1,760 with only 186 listed, while its price sat
  // in the $900-1000 range for the ~50 samples before a ~30hr spike) — the median
  // over a short trailing window is far more robust to that than trusting the
  // instant snapshot outright, since a median needs a MAJORITY of samples to move,
  // not just a few. 14 days (~84 samples at the API's ~4hr granularity) comfortably
  // outlasts a multi-day manipulation attempt while still tracking real drift.
  const RECENT_PRICE_WINDOW_DAYS = 14;
  const fetchBerryRecentPriceHistory = () => fetchHistoryStats(BERRY_ITEM_IDS, "min", RECENT_PRICE_WINDOW_DAYS);
  // Same correction, extended to BP-shop items and crafting ingredients — a
  // live sweep across every tracked item found the identical failure mode
  // elsewhere: Ring Target's snapshot read $5,000 vs. a $12,450 14-day median
  // (thin market, only 114 listed), and Heal Powder read $800 vs. $530 — the
  // latter feeds crafting-recipe cost calcs directly, same as Petaya fed
  // berry revenue calcs.
  const fetchBpItemRecentPriceHistory = () => fetchHistoryStats(BP_SHOP_ITEM_IDS, "min", RECENT_PRICE_WINDOW_DAYS);
  const fetchCraftIngredientRecentPriceHistory = () => fetchHistoryStats(CRAFT_INGREDIENT_ITEM_IDS, "min", RECENT_PRICE_WINDOW_DAYS);
  const fetchMarketWatchRecentPriceHistory = () => fetchHistoryStats(MARKET_WATCH_ITEM_IDS, "min", RECENT_PRICE_WINDOW_DAYS);
  const fetchMarketWatchLiquidityHistory = () => fetchLiquidityHistory(MARKET_WATCH_ITEM_IDS);

  // ── Species list (sorted by growHours, then name) ────────────────────────
  // marketPrice default = basePrice + 100 (set as string so field shows it)
  const S = (id, name, bpt, base, gh, hd, seeds, tag) => ({
    id, name, tag,
    berriesPerTree: bpt,
    basePrice: base,
    marketPrice: String(base + 100),
    growHours: gh,
    harvestDays: hd,
    seeds,
  });
  const VSp = "Very Spicy", PSp = "Plain Spicy";
  const VSw = "Very Sweet",  PSw = "Plain Sweet";
  const VB  = "Very Bitter", PB  = "Plain Bitter";
  const VSo = "Very Sour",   PSo = "Plain Sour";
  const VD  = "Very Dry",    PD  = "Plain Dry";

  // Tag order also drives the Berry Optimizer dropdown's grouping — this array's
  // order IS the display order, starting with Leppa/Sitrus/Lum per the user.
  const TAG_ORDER = ["Utility", "EV", "Status", "Crafting", "Resist"];

  const DEFAULT_SPECIES = [
    // ── Leppa + Sitrus + Lum ──
    S(1,"Leppa",   6,   600, 20, 1, {[VSp]:1,[PSw]:1,[PB]:1}, "Utility"),
    S(2,"Sitrus",  8.5, 800, 44, 2, {[VB]:1, [VSo]:1,[VSw]:1}, "Utility"),
    S(3,"Lum",     8.5, 800, 44, 2, {[VD]:1, [VSp]:1,[VSw]:1}, "Utility"),
    // ── NPC berries (EV Reset) ──
    S(4,"Pomeg",   8,   600, 44, 2, {[PB]:1, [VSp]:1,[PSp]:1}, "EV"),
    S(5,"Kelpsy",  8,   600, 44, 2, {[VD]:1, [PD]:1, [PSo]:1}, "EV"),
    S(6,"Qualot",  8,   600, 44, 2, {[PSp]:1,[VSw]:1,[PSw]:1}, "EV"),
