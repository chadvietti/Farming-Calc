  function CraftingCalculator({ metrics, ingredientPrices, setIngredientPrices, ingredientQuantities,
                                 craftItemPrices, setCraftItemPrices, craftItemQuantities, craftLiquidity }) {
    const metricsByName = useMemo(() => {
      const m = {};
      metrics.forEach(x => { m[x.name] = x; });
      return m;
    }, [metrics]);

    const [selectedName,   setSelectedName]   = useState(CRAFTING_RECIPES[0].name);
    const [bpSource,        setBpSource]       = useState("direct"); // "direct" | one of THREE_DAY_BERRIES
    const [derivedSource,   setDerivedSource]  = useState({ "Heal Powder": "craft", "Energy Powder": "craft" });

    const showMostProfitable = () => {
      let best = null;
      THREE_DAY_BERRIES.forEach(berryName => {
        const opt = bestCraftOptionForBerry(berryName, metricsByName, ingredientPrices, craftItemPrices, derivedSource);
        if (opt && (!best || opt.netPerDay > best.netPerDay)) best = { ...opt, berryName };
      });
      if (best) { setSelectedName(best.recipeName); setBpSource(best.berryName); }
    };

    const recipe = CRAFTING_RECIPES.find(r => r.name === selectedName);
    const sellPrice = craftItemPrices[recipe.name] || 0;
    const sellFee   = listingFee(sellPrice);
    const sellNet   = sellPrice - sellFee; // GTL only — in-person "Direct" trade is Leppa/seeds only, not crafted items

    const ingredientCostPerCraft = recipe.ingredients.reduce((sum, ing) =>
      sum + ing.qty * ingredientUnitCost(ing.name, metricsByName, ingredientPrices, derivedSource), 0);

    // Breakeven threshold — independent of which Berry Powder source you pick
    const maxBPCost = (sellNet - ingredientCostPerCraft) / recipe.bp;

    // Every possible Berry Powder source: grow one of the 5 three-day berries, or buy the powder directly
    const bpOptions = THREE_DAY_BERRIES.map(name => {
      const sp = metricsByName[name];
      if (!sp) return null;
      const powderYield = sp.berriesPerTree * PLOTS; // 1 berry → 1 powder, free
      return { key:name, label:`Grow: ${name}`, costPerPowder: sp.seedCost / powderYield, sp, powderYield };
    }).filter(Boolean);
    bpOptions.push({ key:"direct", label:"Buy directly (GTL)", costPerPowder: ingredientPrices["Berry Powder"] || 0, sp:null });

    const chosen = bpOptions.find(o => o.key === bpSource) || bpOptions[0];
    const actualNetPerCraft = sellNet - ingredientCostPerCraft - recipe.bp * chosen.costPerPowder;
    let chosenNetPerDay = null;
    if (chosen.sp) {
      const craftsPerHarvest = chosen.powderYield / recipe.bp;
      const netProfit = craftsPerHarvest * sellNet - craftsPerHarvest * ingredientCostPerCraft - chosen.sp.seedCost;
      chosenNetPerDay = netProfit * chosen.sp.cyclesPerDay;
    }
    // Sanity check: even a FREE berry isn't worth converting if the recipe can't
    // afford to pay more per powder than you'd get just selling that berry outright
    // (its own best NPC/GTL/Trade price). Catches "profitable-looking" recipes that
    // are actually worse than the opportunity cost of the berry itself.
    const chosenOpportunityCost = chosen.sp ? chosen.sp.effectivePrice : null;
    const worseThanSelling = chosenOpportunityCost !== null && maxBPCost < chosenOpportunityCost;

    // Ranked by margin/powder — the one universally comparable number across grown vs. bought
    const rankedRows = bpOptions.map(o => {
      let netPerDay = null;
      if (o.sp) {
        const craftsPerHarvest = o.powderYield / recipe.bp;
        const netProfit = craftsPerHarvest * sellNet - craftsPerHarvest * ingredientCostPerCraft - o.sp.seedCost;
        netPerDay = netProfit * o.sp.cyclesPerDay;
      }
      return {
        key: o.key, label: o.label, costPerPowder: o.costPerPowder,
        margin: maxBPCost - o.costPerPowder,
        netPerCraft: sellNet - ingredientCostPerCraft - recipe.bp * o.costPerPowder,
        netPerDay,
        opportunityCost: o.sp ? o.sp.effectivePrice : null,
        worseThanSelling: o.sp ? maxBPCost < o.sp.effectivePrice : false,
      };
    }).sort((a,b) => b.margin - a.margin);
    const bestRow = rankedRows[0];

    const CATEGORY_ORDER = ["Restores", "Ethers", "Vitamins", "Hyper Vitamins"];

    return (
      <div style={{ background:COL.card, border:"1px solid #2a1a4a", borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
        <div style={{ fontSize:"11px", color:COL.purple, letterSpacing:"2px", textTransform:"uppercase", marginBottom:"16px" }}>
          🧪 Crafting Calculator — Berry Powder Profitability
        </div>
        <div style={{ fontSize:"11px", color:"#4a4a6a", marginBottom:"16px" }}>
          Any berry crushes into 1 Berry Powder at 0 cost, and Berry Powder itself is also directly
          tradeable — so this compares buying it outright against growing it yourself.
        </div>

        <div style={{ display:"flex", gap:"10px", alignItems:"flex-end", marginBottom:"16px", flexWrap:"wrap" }}>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px", flex:"1 1 auto" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Item to craft</label>
            <select value={selectedName} onChange={e => setSelectedName(e.target.value)}
              style={{ ...fs, cursor:"pointer" }}>
              {CATEGORY_ORDER.map(cat => (
                <optgroup key={cat} label={cat}>
                  {CRAFTING_RECIPES.filter(r => r.category === cat).map(r => (
                    <option key={r.name} value={r.name}>{r.name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
          <button onClick={showMostProfitable}
            style={{ background:"#0a2a1a", border:"1px solid #1a4a2a", borderRadius:"6px",
              color:COL.accent, padding:"7px 14px", fontSize:"12px", cursor:"pointer", whiteSpace:"nowrap" }}>
            🏆 Show Most Profitable
          </button>
        </div>

        <div style={{ fontSize:"11px", color:COL.muted, marginBottom:"8px" }}>
          Recipe: <span style={{ color:COL.text }}>{recipe.bp} Berry Powder</span>
          {recipe.ingredients.map(ing => <span key={ing.name}> + {ing.qty} {ing.name}</span>)}
        </div>

        <div style={{ display:"grid", gridTemplateColumns:`repeat(${1 + recipe.ingredients.length},1fr)`, gap:"8px", marginBottom:"16px" }}>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>{recipe.name} sell price $</label>
            <input type="number" value={sellPrice}
              onChange={e => setCraftItemPrices(p => ({ ...p, [recipe.name]: Number(e.target.value) }))}
              style={fs} />
            {(() => {
              const liq = liquidityFlag(craftItemQuantities[recipe.name], craftLiquidity[recipe.name]);
              if (!liq) return null;
              const color = liq.status === "sparse" ? COL.red : liq.status === "flooded" ? COL.blue : "#4a4a6a";
              const icon = liq.status === "sparse" ? "▼ " : liq.status === "flooded" ? "▲ " : "";
              return (
                <span style={{ fontSize:"9px", color }}>
                  {icon}now {fmt(liq.currentQty)} · avg/1yr {fmt(liq.avg)} ({liq.ratio.toFixed(2)}×)
                </span>
              );
            })()}
          </div>
          {recipe.ingredients.map(ing => {
            const isBerry = !!CRAFT_BERRY_SOURCE[ing.name];
            const thinQty = ingredientQuantities[ing.name];
            const thinFlag = thinQty !== undefined && thinQty < CRAFT_THIN_THRESHOLD && (
              <span style={{ fontSize:"9px", color:COL.gold }}>⚠ thin ({fmt(thinQty)} listed)</span>
            );
            if (isBerry) {
              const unitCost = ingredientUnitCost(ing.name, metricsByName, ingredientPrices, derivedSource);
              return (
                <div key={ing.name} style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"11px", color:COL.muted }}>{ing.name} $ <span style={{color:"#4a4a6a"}}>(GTL, tracked)</span></label>
                  <div style={{ ...fs, background:"#0f1a0f", border:"1px solid #1a4a1a", color:"#86efac", display:"flex", alignItems:"center" }}>
                    ${fmt(unitCost)}
                  </div>
                </div>
              );
            }
            if (ing.name === "Heal Powder" || ing.name === "Energy Powder") {
              const unitCost = ingredientUnitCost(ing.name, metricsByName, ingredientPrices, derivedSource);
              return (
                <DerivedIngredientInput key={ing.name} ing={ing}
                  ingredientPrices={ingredientPrices} setIngredientPrices={setIngredientPrices}
                  derivedSource={derivedSource} setDerivedSource={setDerivedSource}
                  unitCost={unitCost}
                  craftLabel={ing.name === "Heal Powder" ? "Craft (Lum Berry ×2)" : "Craft (Energy Root ×4)"} />
              );
            }
            return (
              <div key={ing.name} style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                <label style={{ fontSize:"11px", color:COL.muted }}>{ing.name} $</label>
                <input type="number" value={ingredientPrices[ing.name] || 0}
                  onChange={e => setIngredientPrices(p => ({ ...p, [ing.name]: Number(e.target.value) }))}
                  style={fs} />
                {thinFlag}
              </div>
            );
          })}
        </div>

        <div style={{ background:"#0d0d1f", borderRadius:"8px", padding:"14px", marginBottom:"16px",
          border:`1px solid ${maxBPCost >= 0 ? "#1a4a1a" : "#4a1a1a"}` }}>
          <div style={{ fontSize:"11px", color:COL.muted, marginBottom:"4px" }}>
            Max profitable Berry Powder cost <span style={{color:"#4a4a6a"}}>(sell net − ingredients) / {recipe.bp} BP</span>
          </div>
          <div style={{ fontSize:"24px", fontWeight:"700", color: maxBPCost >= 0 ? COL.gold : COL.red }}>
            ${fmt(maxBPCost)}<span style={{ fontSize:"12px", fontWeight:"400", color:COL.muted }}> /powder (breakeven)</span>
          </div>
        </div>

        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:"8px", marginBottom:"20px" }}>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Berry Powder source</label>
            <select value={bpSource} onChange={e => setBpSource(e.target.value)}
              style={{ ...fs, cursor:"pointer" }}>
              {bpOptions.map(o => (
                <option key={o.key} value={o.key}>{o.label} — ${o.costPerPowder.toFixed(1)}/powder</option>
              ))}
            </select>
            {bpSource === "direct" && (
              <div style={{ display:"flex", alignItems:"center", gap:"6px", marginTop:"3px", flexWrap:"wrap" }}>
                <span style={{ fontSize:"10px", color:COL.muted }}>Berry Powder GTL price $</span>
                <input type="number" value={ingredientPrices["Berry Powder"] || 0}
                  onChange={e => setIngredientPrices(p => ({ ...p, "Berry Powder": Number(e.target.value) }))}
                  style={{ ...fs, width:"90px" }} />
                {ingredientQuantities["Berry Powder"] !== undefined && ingredientQuantities["Berry Powder"] < CRAFT_THIN_THRESHOLD && (
                  <span style={{ fontSize:"9px", color:COL.gold }}>⚠ thin ({fmt(ingredientQuantities["Berry Powder"])} listed)</span>
                )}
              </div>
            )}
          </div>
          <div style={{ background: actualNetPerCraft >= 0 ? "#0a1a0a" : "#1a0a0a",
            border:`1px solid ${actualNetPerCraft >= 0 ? "#1a4a1a" : "#4a1a1a"}`, borderRadius:"8px", padding:"10px 12px" }}>
            <div style={{ fontSize:"10px", color:COL.muted, marginBottom:"2px" }}>Net using this source</div>
            <div style={{ fontSize:"18px", fontWeight:"700", color: actualNetPerCraft >= 0 ? COL.accent : COL.red }}>
              {actualNetPerCraft >= 0 ? "+" : ""}${fmt(actualNetPerCraft)}<span style={{ fontSize:"11px", fontWeight:"400", color:COL.muted }}> /craft</span>
            </div>
            {chosenNetPerDay !== null && (
              <div style={{ fontSize:"12px", color:COL.gold, marginTop:"2px" }}>${fmt(chosenNetPerDay)} /day growing {chosen.key}</div>
            )}
          </div>
        </div>

        {worseThanSelling && (
          <div style={{ background:"#1a1500", border:"1px solid #5a5a00", borderRadius:"8px", padding:"10px 12px", marginBottom:"16px", fontSize:"11px", color:COL.gold }}>
            ⚠ Selling {chosen.key} outright (${fmt(chosenOpportunityCost)}/berry) beats this recipe's ${fmt(maxBPCost)}/powder
            breakeven — converting to powder loses money vs. just selling the berry, even ignoring growing cost.
          </div>
        )}

        <div style={{ fontSize:"11px", color:"#7dd3fc", letterSpacing:"1px", textTransform:"uppercase", marginBottom:"10px" }}>
          All Berry Powder Sources, Ranked by Margin
        </div>
        <div style={{ overflowX:"auto" }}>
          <table style={{ width:"100%", borderCollapse:"collapse", fontSize:"12px", minWidth:"560px" }}>
            <thead>
              <tr style={{ color:COL.muted, borderBottom:`1px solid ${COL.border}` }}>
                {["Source","Cost / Powder","Margin vs. Max","Net/Craft","Net/Day"].map(h => (
                  <th key={h} style={{ padding:"7px 8px", textAlign:h==="Source"?"left":"right", fontWeight:"400" }}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rankedRows.map(r => {
                const isBest = bestRow && r.key === bestRow.key;
                return (
                  <tr key={r.key} style={{ background:isBest ? "#0a1a12" : "transparent", borderBottom:`1px solid ${COL.border}` }}>
                    <td style={{ padding:"9px 8px", color:isBest ? COL.accent : COL.purple, fontWeight:isBest?"700":"400" }}>
                      {isBest ? "★ " : ""}{r.label}
                      {r.worseThanSelling && (
                        <span style={{ color:COL.gold, marginLeft:"4px", fontSize:"10px" }} title={`Selling outright nets $${fmt(r.opportunityCost)}/berry, more than this recipe's breakeven`}>⚠</span>
                      )}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted }}>${r.costPerPowder.toFixed(1)}</td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:r.margin >= 0 ? COL.accent : COL.red }}>
                      {r.margin >= 0 ? "+" : ""}${r.margin.toFixed(1)}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:r.netPerCraft >= 0 ? COL.text : COL.red }}>
                      {r.netPerCraft >= 0 ? "+" : ""}${fmt(r.netPerCraft)}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right",
                      color:isBest ? COL.gold : COL.text, fontWeight:isBest?"700":"400" }}>
                      {r.netPerDay !== null ? `$${fmt(r.netPerDay)}` : "—"}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    );
  }

  // ── RawMaterialsPriceTable — moved to its own Price Analysis page, per the
  // user, so it's not buried inside the Crafting Calculator's recipe UI ──────────
  function RawMaterialsPriceTable({ ingredientPrices, rawMaterialPriceHistory }) {
