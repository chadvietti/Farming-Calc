    S(27,"Coba",    8, 700, 42, 2, {[VB]:1, [PB]:1, [VD]:1}, "Resist"),
    S(28,"Payapa",  8, 700, 42, 2, {[VSo]:1,[PSo]:1,[VSw]:1}, "Resist"),
