          </div>
          <button onClick={onRemove} style={{ background:"#3a1a1a", border:"1px solid #6a2a2a",
            borderRadius:"4px", color:COL.red, fontSize:"11px", padding:"3px 10px", cursor:"pointer" }}>Remove</button>
        </div>
        <div style={{ display:"grid", gridTemplateColumns:"repeat(4, 1fr)", gap:"8px", marginBottom:"12px" }}>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>Berries/tree</label>
            <input type="number" value={species.berriesPerTree}
              onChange={e => onUpdate({ ...species, berriesPerTree: Number(e.target.value) })} style={fs} />
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:COL.muted }}>
              Grow hrs <span style={{ color:"#4a4a6a" }}>({theorDays % 1 === 0 ? theorDays : theorDays.toFixed(2)}d)</span>
            </label>
            <input type="number" value={species.growHours}
              onChange={e => onUpdate({ ...species, growHours: Number(e.target.value) })} style={fs} />
          </div>
          <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
            <label style={{ fontSize:"11px", color:waitPenalty ? COL.gold : COL.muted }}>
              Harvest days {waitPenalty && <span style={{ fontSize:"10px" }}>⚠ idle</span>}
