    S(31,"Babiri",  8, 700, 42, 2, {[VD]:1, [VSp]:1,[PSp]:1}, "Resist"),
    S(32,"Chilan",  8, 700, 42, 2, {[VD]:1, [PD]:1, [VSw]:1}, "Resist"),
    S(33,"Charti",  8, 700, 42, 2, {[VD]:1, [PD]:1, [VSp]:1}, "Resist"),
    S(34,"Kasib",   8, 700, 42, 2, {[VD]:1, [VSw]:1,[PSw]:1}, "Resist"),
    S(35,"Haban",   8, 700, 42, 2, {[VB]:1, [PB]:1, [VSw]:1}, "Resist"),
    S(36,"Passho",  8, 700, 42, 2, {[VB]:1, [VD]:1, [PD]:1}, "Resist"),
  ];

  const PLOTS = 156;

  // ── GTL listing fee — tiered, not flat ───────────────────────────────────────
  // ≤$2,000: flat $100 · $2,001–$500,000: 5% of unit price · above: capped at $25,000.
  // Every berry/seed in this app is well under $2,000, so this always resolves
  // to the flat fee today, but the formula is correct generally.
  function listingFee(price) {
    if (price <= 2000) return 100;
    if (price <= 500000) return price * 0.05;
    return 25000;
  }

  const COL = {
    bg: "#0d0d1f", card: "#11112a", border: "#1e1e3f",
    accent: "#6ee7b7", purple: "#c084fc", gold: "#fbbf24",
    red: "#f87171", blue: "#60a5fa", muted: "#6b7280", text: "#e2e8f0",
  };
  const TAG_META = {
    "Utility": { color: COL.gold,   bg: "#2a2410", border: "#5a4a10" },
    "EV":                   { color: COL.blue,   bg: "#0f1a2a", border: "#1a3a5a" },
    "Status":                { color: COL.red,    bg: "#2a1414", border: "#5a2a2a" },
    "Crafting":              { color: COL.accent, bg: "#0a1a12", border: "#1a4a2a" },
    "Resist":                { color: COL.purple, bg: "#1e1430", border: "#4a2a6a" },
  };
  const fs = {
    background: "#1a1a2e", border: "1px solid #2a2a4a", borderRadius: "4px",
    color: COL.text, padding: "4px 8px", fontSize: "13px", fontFamily: "monospace", width: "100%",
  };
  function fmt(n) { return Math.round(n).toLocaleString(); }

  // ── calcMetrics ──────────────────────────────────────────────────────────────
  // Seeds are, along with Leppa berries, the only other thing generally traded
  // in person rather than through the GTL — same flat half-fee discount convention.
  const SEED_TRADE_DISCOUNT = 50;

  // pricingMode: "auto" (best available channel) | "npc" (force NPC) | "market" (force GTL)
  // Direct/in-person trade is only realistic for Leppa in practice — every other
  // berry's "effective price" is just the GTL net, full fee, no trade discount.
  // seedCostBasis: "gtl" (full listed seed price) | "fair" (seed price minus the
  // in-person trade discount, since seeds are commonly traded directly too)
  function calcMetrics(sp, seedPrices, pricingMode, seedCostBasis, leppaTradeDiscount) {
    const mode = pricingMode || "auto";
    const mp = sp.marketPrice !== "" ? Number(sp.marketPrice) : sp.basePrice + 100;
    const fee       = listingFee(mp);
    const npcNet    = sp.basePrice;      // NPC vendor sale, no fee
    const marketNet = mp - fee;          // GTL listing, full fee
    const isLeppa   = sp.name === "Leppa";
    // In-person trade discount is only realistic for Leppa — user-editable
    // since it varies $50-80 depending on demand. Floored to the nearest $10
    // (not just the discount itself, but the resulting Trade value) since
    // in-person quotes are always round numbers, even when mp isn't.
    const tradeNet  = isLeppa ? Math.floor((mp - (leppaTradeDiscount ?? 50)) / 10) * 10 : null;

    let effectivePrice, sellChannel;
    if (mode === "npc") {
      effectivePrice = npcNet; sellChannel = "NPC";
    } else if (mode === "market") {
      effectivePrice = marketNet; sellChannel = "GTL";
    } else {
      const channels = { NPC: npcNet, GTL: marketNet, ...(isLeppa ? { Trade: tradeNet } : {}) };
      sellChannel    = Object.keys(channels).reduce((a, b) => channels[b] > channels[a] ? b : a);
      effectivePrice = channels[sellChannel];
    }

    const revenue        = sp.berriesPerTree * PLOTS * effectivePrice;
    const seedUnitCost   = (price) => seedCostBasis === "fair" ? Math.max(0, price - SEED_TRADE_DISCOUNT) : price;
    const seedCost       = Object.entries(sp.seeds).reduce(
      (s, [seed, qty]) => s + qty * PLOTS * seedUnitCost(seedPrices[seed] || 0), 0);
    const netProfit   = revenue - seedCost;
    const margin      = revenue > 0 ? (netProfit / revenue) * 100 : 0;
    const theorDays   = sp.growHours / 24;
    const practicalDays = sp.harvestDays || Math.ceil(theorDays);
    const cyclesPerDay = 1 / practicalDays;
    const netPerDay    = netProfit * cyclesPerDay;
    const waitPenalty = practicalDays > theorDays + 0.01;

    // Leppa gets a full parallel breakdown for both realistic sale channels
    // (GTL and in-person Trade), not just whichever nets more — the table
    // shows both side by side instead of collapsing to one number.
    let gtl = null, trade = null;
    if (isLeppa) {
      const mk = (price) => {
        const rev = sp.berriesPerTree * PLOTS * price;
        const np  = rev - seedCost; // seedCost doesn't depend on sell channel
        return { revenue: rev, netProfit: np,
          margin: rev > 0 ? (np / rev) * 100 : 0, netPerDay: np * cyclesPerDay };
      };
      gtl = mk(marketNet);
      trade = mk(tradeNet);
    }

    return { revenue, seedCost, netProfit, margin, cyclesPerDay, netPerDay,
             effectivePrice, marketNet, npcNet, tradeNet, isLeppa, sellChannel, mp,
             theorDays, practicalDays, waitPenalty, gtl, trade };
  }

  // ── SeedChip ─────────────────────────────────────────────────────────────────
