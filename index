      </div>
    );
  }

  // ── BpConversionTable — Battle Points redemption value, $/BP at current GTL
  // prices vs. each item's own 1yr average ────────────────────────────────────
  function BpConversionTable({ bpItemPrices, bpItemPriceHistory, bpItemQuantities, bpItemLiquidity }) {
    const [sortBy, setSortBy] = useState("tier");
    const [hideUntradable, setHideUntradable] = useState(false);

    const rows = BP_SHOP_ITEMS.map(it => {
      // Untradable items (Power items, Ability Pill) have no real GTL price —
      // synthesize the same fields from their fixed NPC cost instead, so every
      // column stays populated and directly comparable to fluctuating items.
      // Current == 1yr avg by construction (it never moves), so ratio is
      // always exactly 1 — redundant, but keeps the row shape uniform.
      if (it.untradable) {
        const perBp = it.npcAlt / it.bp;
        return { ...it, current: it.npcAlt, perBp, avg: it.npcAlt, ratio: 1, status: "untradable", liq: null };
      }
      const current = bpItemPrices[it.name];
      if (current === undefined) return { ...it, current: null };
      const net = current - listingFee(current);
      const perBp = net / it.bp;
      const stats = bpItemPriceHistory[it.name];
      let ratio = null, status = "unknown";
      if (stats && stats.avg) {
        ratio = current / stats.avg;
        status = ratio >= PRICE_EXPENSIVE_RATIO ? "convert" : ratio <= PRICE_CHEAP_RATIO ? "hold" : "normal";
      }
      const liq = liquidityFlag(bpItemQuantities[it.name], bpItemLiquidity[it.name]);
      return { ...it, current, perBp, avg: stats ? stats.avg : null, ratio, status, liq };
    });
    const best = rows.filter(r => r.current !== null).reduce(
      (a, b) => (!a || b.perBp > a.perBp) ? b : a, null);

    const visibleRows = hideUntradable ? rows.filter(r => !r.untradable) : rows;
    const sortedRows = [...visibleRows].sort((a, b) => {
      if (a.current === null && b.current === null) return 0;
      if (a.current === null) return 1;
      if (b.current === null) return -1;
      switch (sortBy) {
        case "name":    return a.name.localeCompare(b.name);
        case "bp":      return a.bp - b.bp;
        case "current": return b.current - a.current;
        case "perBp":   return b.perBp - a.perBp;
        case "ratio":   return (b.ratio ?? -Infinity) - (a.ratio ?? -Infinity);
        default:        return 0; // "tier" — keep the catalog's own BP-tier order
      }
    });

    return (
      <div style={{ background:COL.card, border:"1px solid #2a1a4a", borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:"10px", marginBottom:"4px" }}>
          <div style={{ fontSize:"11px", color:"#7dd3fc", letterSpacing:"2px", textTransform:"uppercase" }}>
            BP Conversion — What's Your Battle Points Worth?
          </div>
          <div style={{ display:"flex", gap:"8px", flexWrap:"wrap" }}>
            <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
              <label style={{ fontSize:"10px", color:COL.muted }}>Untradable</label>
              <button onClick={() => setHideUntradable(v => !v)}
                style={{
                  background: hideUntradable ? "#2a1414" : COL.card,
                  border:`1px solid ${hideUntradable ? "#7a3a3a" : COL.border}`,
                  borderRadius:"6px", color: hideUntradable ? COL.red : COL.muted,
                  padding:"7px 10px", fontSize:"11px", cursor:"pointer", whiteSpace:"nowrap" }}>
                {hideUntradable ? "▼ Hidden" : "Hide Untradable"}
              </button>
            </div>
            <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
              <label style={{ fontSize:"10px", color:COL.muted }}>Sort by</label>
              <select value={sortBy} onChange={e => setSortBy(e.target.value)}
                style={{ ...fs, width:"auto", fontSize:"11px", cursor:"pointer" }}>
                <option value="tier">BP Tier (default)</option>
                <option value="name">Alphabetical</option>
                <option value="bp">BP Cost</option>
                <option value="current">Current $</option>
                <option value="perBp">$ / BP</option>
                <option value="ratio">Ratio</option>
              </select>
            </div>
          </div>
        </div>
        <div style={{ fontSize:"11px", color:"#4a4a6a", marginBottom:"14px" }}>
          $/BP = (current GTL price − listing fee) ÷ BP cost — what redeeming and immediately selling nets you per Battle Point.
          Ratio = current price ÷ its own 1yr average — ≥{PRICE_EXPENSIVE_RATIO}× (priced unusually high right now) is a good time to sell if you're holding any; ≤{PRICE_CHEAP_RATIO}× (unusually low) means hold your BP, or just buy the item on GTL directly if you need it.
          Liquidity uses the same ratio bounds as crafted items (▼ sparse at ≤{LIQUIDITY_SPARSE_RATIO}×, ▲ flooded at ≥{LIQUIDITY_FLOODED_RATIO}×) — no absolute-count floor here.
          ⛔ Untradable (Power items, Ability Pill) can't be listed on GTL at all — Current $/1yr Avg/Ratio are synthesized from the fixed NPC price so $/BP still lines up against fluctuating items; Signal reads "Untradeable" instead of a buy/hold call.
        </div>
        <div style={{ overflowX:"auto" }}>
          <table style={{ width:"100%", borderCollapse:"collapse", fontSize:"12px", minWidth:"700px" }}>
            <thead>
              <tr style={{ color:COL.muted, borderBottom:`1px solid ${COL.border}` }}>
                {["Item","BP Cost","Current $","Liquidity","$ / BP","1yr Avg $","Ratio","Signal"].map(h => (
                  <th key={h} style={{ padding:"7px 8px", textAlign:h==="Item"?"left":"right", fontWeight:"400" }}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {sortedRows.map(r => {
                if (r.current === null) return (
                  <tr key={r.name} style={{ borderBottom:`1px solid ${COL.border}` }}>
                    <td style={{ padding:"9px 8px", color:COL.purple }}>{r.name}</td>
                    <td colSpan={7} style={{ padding:"9px 8px", textAlign:"right", color:"#4a4a6a" }}>no data yet</td>
                  </tr>
                );
                const isBest = best && r.name === best.name;
                const color = r.status === "convert" ? COL.accent : r.status === "hold" ? COL.red
                  : r.status === "untradable" ? COL.red : COL.text;
                const signal = r.status === "convert" ? "✓ Good time to sell"
                  : r.status === "hold" ? "✗ Hold BP / buy on GTL"
                  : r.status === "untradable" ? "⛔ Untradeable"
                  : r.status === "unknown" ? "— no history" : "— Normal range";
                const liqColor = r.liq?.status === "sparse" ? COL.red : r.liq?.status === "flooded" ? COL.blue : COL.muted;
                const liqIcon = r.liq?.status === "sparse" ? "▼ " : r.liq?.status === "flooded" ? "▲ " : "";
                return (
                  <tr key={r.name} style={{ background:isBest ? "#0a1a12" : "transparent", borderBottom:`1px solid ${COL.border}` }}>
                    <td style={{ padding:"9px 8px", color:isBest ? COL.accent : COL.purple, fontWeight:isBest ? "700" : "400" }}>
                      {isBest ? "★ " : ""}{r.name}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted }}>{fmt(r.bp)}</td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:COL.text }}>${fmt(r.current)}</td>
                    <td style={{ padding:"9px 8px", textAlign:"right" }}>
                      {r.liq ? (
                        <span style={{ color:liqColor, fontWeight:r.liq.status==="normal" ? "400" : "700" }}>
                          {liqIcon}{fmt(r.liq.currentQty)}
                        </span>
                      ) : <span style={{ color:"#4a4a6a" }}>—</span>}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", fontWeight:"700", color:isBest ? COL.gold : COL.text }}>
                      ${r.perBp.toFixed(2)}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted }}>
                      {r.avg !== null ? `$${fmt(r.avg)}` : "—"}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color, fontWeight:r.status==="normal" ? "400" : "700" }}>
                      {r.ratio !== null ? `${r.ratio.toFixed(2)}×` : "—"}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color }}>{signal}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    );
  }

  // ── MarketWatchTable — general, user-extensible investment tracking (not tied
  // to BP redemption) — same price-timing + liquidity treatment as everything
  // else, just framed as plain buy/sell signals like the raw-materials table ──
  function MarketWatchTable({ marketWatchPrices, marketWatchPriceHistory, marketWatchQuantities, marketWatchLiquidity }) {
    const rows = Object.values(MARKET_WATCH_ITEM_IDS).map(name => {
      const current = marketWatchPrices[name];
      if (current === undefined) return { name, current: null };
      const stats = marketWatchPriceHistory[name];
      let ratio = null, status = "unknown";
      if (stats && stats.avg) {
        ratio = current / stats.avg;
        status = ratio <= PRICE_CHEAP_RATIO ? "cheap" : ratio >= PRICE_EXPENSIVE_RATIO ? "expensive" : "normal";
      }
      const liq = liquidityFlag(marketWatchQuantities[name], marketWatchLiquidity[name]);
      return { name, current, avg: stats ? stats.avg : null, ratio, status, liq };
    });

    return (
      <div style={{ background:COL.card, border:"1px solid #2a1a4a", borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
        <div style={{ fontSize:"11px", color:"#7dd3fc", letterSpacing:"2px", textTransform:"uppercase", marginBottom:"4px" }}>
          Market Watch — Investment Tracking
        </div>
        <div style={{ fontSize:"11px", color:"#4a4a6a", marginBottom:"14px" }}>
          Cheap now (≤{PRICE_CHEAP_RATIO}× 1yr avg) is a good time to buy; expensive now (≥{PRICE_EXPENSIVE_RATIO}× avg) is a good time to sell.
          Liquidity uses the same ratio bounds as crafted items (▼ sparse at ≤{LIQUIDITY_SPARSE_RATIO}×, ▲ flooded at ≥{LIQUIDITY_FLOODED_RATIO}×) — no absolute-count floor.
        </div>
        <div style={{ overflowX:"auto" }}>
          <table style={{ width:"100%", borderCollapse:"collapse", fontSize:"12px", minWidth:"560px" }}>
            <thead>
              <tr style={{ color:COL.muted, borderBottom:`1px solid ${COL.border}` }}>
                {["Item","Current $","Liquidity","1yr Avg $","Ratio","Signal"].map(h => (
                  <th key={h} style={{ padding:"7px 8px", textAlign:h==="Item"?"left":"right", fontWeight:"400" }}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map(r => {
                if (r.current === null) return (
                  <tr key={r.name} style={{ borderBottom:`1px solid ${COL.border}` }}>
                    <td style={{ padding:"9px 8px", color:COL.purple }}>{r.name}</td>
                    <td colSpan={5} style={{ padding:"9px 8px", textAlign:"right", color:"#4a4a6a" }}>no data yet</td>
                  </tr>
                );
                const color = r.status === "cheap" ? COL.accent : r.status === "expensive" ? COL.red : COL.text;
                const signal = r.status === "cheap" ? "✓ Good time to buy"
                  : r.status === "expensive" ? "✗ Expensive — good time to sell"
                  : r.status === "unknown" ? "— no history" : "— Normal range";
                const liqColor = r.liq?.status === "sparse" ? COL.red : r.liq?.status === "flooded" ? COL.blue : COL.muted;
                const liqIcon = r.liq?.status === "sparse" ? "▼ " : r.liq?.status === "flooded" ? "▲ " : "";
                return (
                  <tr key={r.name} style={{ borderBottom:`1px solid ${COL.border}` }}>
                    <td style={{ padding:"9px 8px", color:COL.purple }}>{r.name}</td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:COL.text }}>${fmt(r.current)}</td>
                    <td style={{ padding:"9px 8px", textAlign:"right" }}>
                      {r.liq ? (
                        <span style={{ color:liqColor, fontWeight:r.liq.status==="normal" ? "400" : "700" }}>
                          {liqIcon}{fmt(r.liq.currentQty)}
                        </span>
                      ) : <span style={{ color:"#4a4a6a" }}>—</span>}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color:COL.muted }}>
                      {r.avg !== null ? `$${fmt(r.avg)}` : "—"}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color, fontWeight:r.status==="normal" ? "400" : "700" }}>
                      {r.ratio !== null ? `${r.ratio.toFixed(2)}×` : "—"}
                    </td>
                    <td style={{ padding:"9px 8px", textAlign:"right", color }}>{signal}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    );
  }

  // ── App ───────────────────────────────────────────────────────────────────────
  function App() {
    const [seedPrices,         setSeedPrices]         = useState(DEFAULT_SEED_PRICES);
    const [speciesList,        setSpeciesList]        = useState(DEFAULT_SPECIES);
    const [farmers,            setFarmers]            = useState(6);
    const [showSeedEditor,     setShowSeedEditor]     = useState(false);
    const [showSpeciesEditor,  setShowSpeciesEditor]  = useState(false);
    const [priceSync,          setPriceSync]          = useState({ status:"idle", message:"", syncedAt:null });
    const [craftIngredientPrices, setCraftIngredientPrices] = useState(CRAFT_INGREDIENT_DEFAULTS);
    const [craftItemPrices,       setCraftItemPrices]       = useState(CRAFT_ITEM_PRICE_DEFAULTS);
    const [berryQuantities,       setBerryQuantities]       = useState({});
    const [craftIngredientQuantities, setCraftIngredientQuantities] = useState({});
    const [craftItemQuantities,       setCraftItemQuantities]       = useState({});
    const [pricingMode,           setPricingMode]           = useState("auto"); // "auto" | "npc" | "market"
    const [seedCostBasis,         setSeedCostBasis]         = useState("gtl"); // "gtl" | "fair"
    const [leppaTradeDiscount,    setLeppaTradeDiscount]    = useState(50); // $ off listing, in-person — varies $50-80, always a multiple of 10
    const [berrySortBy,           setBerrySortBy]           = useState("netPerDay");
    const [hideSparseLiquidity,   setHideSparseLiquidity]   = useState(false);
    const [showAllBerries,        setShowAllBerries]        = useState(false);
    const BERRY_TABLE_COLLAPSED_COUNT = 10;
    const [berryLiquidity,        setBerryLiquidity]        = useState({}); // {name: {avg, stdDev}}
    const [craftLiquidity,        setCraftLiquidity]        = useState({});
    const [rawMaterialPriceHistory, setRawMaterialPriceHistory] = useState({});
    const [liquiditySync,         setLiquiditySync]         = useState({ status:"idle", syncedAt:null });
    const [bpItemPrices,          setBpItemPrices]          = useState({});
    const [bpItemQuantities,      setBpItemQuantities]      = useState({});
    const [bpItemPriceHistory,    setBpItemPriceHistory]    = useState({});
    const [bpItemLiquidity,       setBpItemLiquidity]       = useState({});
    const [marketWatchPrices,       setMarketWatchPrices]       = useState({});
    const [marketWatchQuantities,   setMarketWatchQuantities]   = useState({});
    const [marketWatchPriceHistory, setMarketWatchPriceHistory] = useState({});
    const [marketWatchLiquidity,    setMarketWatchLiquidity]    = useState({});
    const [page,                  setPage]                  = useState("farm"); // "farm" | "analysis"

    const syncPrices = () => {
      setPriceSync({ status:"loading", message:"Fetching…", syncedAt:null });
      fetchLivePrices()
        .then(({ seedPrices, berryPrices, berryQuantities: liveQuantities,
                 craftIngredientPrices: liveIngredients, craftIngredientQuantities: liveIngredientQty,
                 craftItemPrices: liveCraftItems, craftItemQuantities: liveCraftItemQty,
                 bpItemPrices: liveBpPrices, bpItemQuantities: liveBpQty,
                 marketWatchPrices: liveWatchPrices, marketWatchQuantities: liveWatchQty }) => {
          setSeedPrices(p => ({ ...p, ...seedPrices }));
          setSpeciesList(list => list.map(sp =>
            berryPrices[sp.name] !== undefined
              ? { ...sp, marketPrice: String(berryPrices[sp.name]) }
              : sp));
          setBerryQuantities(p => ({ ...p, ...liveQuantities }));
          setCraftIngredientPrices(p => ({ ...p, ...liveIngredients }));
          setCraftIngredientQuantities(p => ({ ...p, ...liveIngredientQty }));
          setCraftItemPrices(p => ({ ...p, ...liveCraftItems }));
          setCraftItemQuantities(p => ({ ...p, ...liveCraftItemQty }));
          setBpItemPrices(p => ({ ...p, ...liveBpPrices }));
          setBpItemQuantities(p => ({ ...p, ...liveBpQty }));
          setMarketWatchPrices(p => ({ ...p, ...liveWatchPrices }));
          setMarketWatchQuantities(p => ({ ...p, ...liveWatchQty }));
          const seedCount = Object.keys(seedPrices).length;
          const berryCount = Object.keys(berryPrices).length;
          const craftCount = Object.keys(liveIngredients).length + Object.keys(liveCraftItems).length;
          const bpCount = Object.keys(liveBpPrices).length;
          const watchCount = Object.keys(liveWatchPrices).length;
          setPriceSync({ status:"success",
            message:`Synced ${seedCount} seed + ${berryCount} berry + ${craftCount} crafting + ${bpCount} BP-shop + ${watchCount} watch-list prices`, syncedAt:Date.now() });
        })
        .catch(err => setPriceSync({ status:"error", message:err.message || String(err), syncedAt:null }));

      // Runs in parallel, not chained — much slower (19+19+9+58+58+19+58+13+4+4
      // requests, ~165KB each) and shouldn't hold up the fast price sync above.
      setLiquiditySync({ status:"loading", syncedAt:null });
      Promise.all([fetchBerryLiquidityHistory(), fetchCraftLiquidityHistory(),
                    fetchPriceHistory(RAW_MATERIAL_ITEM_IDS), fetchPriceHistory(BP_SHOP_ITEM_IDS),
                    fetchLiquidityHistory(BP_SHOP_ITEM_IDS), fetchBerryRecentPriceHistory(),
                    fetchBpItemRecentPriceHistory(), fetchCraftIngredientRecentPriceHistory(),
                    fetchPriceHistory(MARKET_WATCH_ITEM_IDS), fetchMarketWatchLiquidityHistory(),
                    fetchMarketWatchRecentPriceHistory()])
        .then(([berryStats, craftStats, rawMaterialStats, bpStats, bpLiquidityStats,
                berryRecentPriceStats, bpRecentPriceStats, craftIngredientRecentPriceStats,
                marketWatchStats, marketWatchLiquidityStats, marketWatchRecentPriceStats]) => {
          setBerryLiquidity(p => ({ ...p, ...berryStats }));
          setCraftLiquidity(p => ({ ...p, ...craftStats }));
          setRawMaterialPriceHistory(p => ({ ...p, ...rawMaterialStats }));
          setBpItemPriceHistory(p => ({ ...p, ...bpStats }));
          setBpItemLiquidity(p => ({ ...p, ...bpLiquidityStats }));
          setMarketWatchPriceHistory(p => ({ ...p, ...marketWatchStats }));
          setMarketWatchLiquidity(p => ({ ...p, ...marketWatchLiquidityStats }));
          // Correct the instant snapshot price to a 14-day median once it's in —
          // a single manipulated/thin-market listing shouldn't drive Market $ or
          // any downstream revenue/profit number. See fetchBerryRecentPriceHistory.
          setSpeciesList(list => list.map(sp => {
            const stats = berryRecentPriceStats[sp.name];
            return stats ? { ...sp, marketPrice: String(Math.round(stats.median)) } : sp;
          }));
          setBpItemPrices(p => {
            const corrected = { ...p };
            Object.entries(bpRecentPriceStats).forEach(([name, stats]) => { corrected[name] = Math.round(stats.median); });
            return corrected;
          });
          setCraftIngredientPrices(p => {
            const corrected = { ...p };
            Object.entries(craftIngredientRecentPriceStats).forEach(([name, stats]) => { corrected[name] = Math.round(stats.median); });
            return corrected;
          });
          setMarketWatchPrices(p => {
            const corrected = { ...p };
            Object.entries(marketWatchRecentPriceStats).forEach(([name, stats]) => { corrected[name] = Math.round(stats.median); });
            return corrected;
          });
          setLiquiditySync({ status:"success", syncedAt:Date.now() });
        })
        .catch(() => setLiquiditySync({ status:"error", syncedAt:null }));
    };

    useEffect(() => { syncPrices(); }, []);

    const metrics = useMemo(() =>
      speciesList.map(sp => ({ ...sp, ...calcMetrics(sp, seedPrices, pricingMode, seedCostBasis, leppaTradeDiscount),
        listedQuantity: berryQuantities[sp.name],
        liquidity: berryLiquidity[sp.name] })),
      [speciesList, seedPrices, pricingMode, seedCostBasis, leppaTradeDiscount, berryQuantities, berryLiquidity]);

    // Hiding sparse-liquidity berries drops them before ranking, so ★ and the
    // sort order both reflect only berries with a realistically fillable market.
    // Two independent reasons count as "sparse" here: a historical-ratio mismatch
    // (thin vs. its own 1yr average) OR an absolute floor (always thin, even if
    // that's "normal" for that item) — either one is enough to hide a row.
    const visibleMetrics = hideSparseLiquidity
      ? metrics.filter(m => {
          const liq = liquidityFlag(m.listedQuantity, m.liquidity);
          return !(liq && (liq.status === "sparse" || liq.lowAbsolute));
        })
      : metrics;

    // Overall best is always by netPerDay — the sort dropdown only changes table display order
    const sortedAll = [...visibleMetrics].sort((a,b) => b.netPerDay - a.netPerDay);
    const overallBest = sortedAll[0];

    const displayRows = [...visibleMetrics].sort((a,b) => {
      switch (berrySortBy) {
        case "name":       return a.name.localeCompare(b.name);
        case "marketPrice": return b.mp - a.mp;
        case "netProfit":  return b.netProfit - a.netProfit;
        case "margin":     return b.margin - a.margin;
        default:           return b.netPerDay - a.netPerDay;
      }
    });

    // Collapsed by default to the top N of whatever sort is active — the full
    // list gets long once every berry category is populated, and most of the
    // time only the leaders matter for a decision.
    const shownRows = showAllBerries ? displayRows : displayRows.slice(0, BERRY_TABLE_COLLAPSED_COUNT);

    const btnStyle = (active, ac, ab, abg) => ({
      background: active ? abg : COL.card,
      border:`1px solid ${active ? ab : COL.border}`,
      borderRadius:"6px", color:active ? ac : COL.muted,
      padding:"7px 16px", fontSize:"12px", cursor:"pointer",
    });

    return (
      <div style={{ background:COL.bg, minHeight:"100vh", padding:"24px 20px" }}>
        <div style={{ maxWidth:"960px", margin:"0 auto" }}>

          {/* Header */}
          <div style={{ marginBottom:"28px" }}>
            <div style={{ fontSize:"10px", color:COL.muted, letterSpacing:"3px", textTransform:"uppercase", marginBottom:"4px" }}>Farm Profit Calculator</div>
            <h1 style={{ fontSize:"24px", fontWeight:"800", color:COL.accent, marginBottom:"4px" }}>Crop Optimizer</h1>
            <div style={{ fontSize:"12px", color:COL.muted }}>
              156 plots/farmer · all seeds from market · profit normalized per day · sells at NPC/GTL (Leppa also trades in person)
            </div>
          </div>

          {/* Controls */}
          <div style={{ display:"flex", gap:"12px", alignItems:"center", marginBottom:"20px", flexWrap:"wrap" }}>
            <div style={{ display:"flex", alignItems:"center", gap:"8px" }}>
              <label style={{ fontSize:"12px", color:COL.muted }}>Farmers:</label>
              <input type="number" value={farmers} min={1}
                onChange={e => setFarmers(Number(e.target.value))}
                style={{ ...fs, width:"70px" }} />
            </div>
            <button onClick={() => setShowSeedEditor(v => !v)}
              style={btnStyle(showSeedEditor,"#7dd3fc","#3a6a9a","#1a2a3a")}>
              {showSeedEditor ? "▲ Hide" : "▼ Edit"} Seed Prices
            </button>
            <button onClick={() => setShowSpeciesEditor(v => !v)}
              style={btnStyle(showSpeciesEditor, COL.purple,"#5a3a9a","#1a1a3a")}>
              {showSpeciesEditor ? "▲ Hide" : "▼ Edit"} Species
            </button>
            <button onClick={syncPrices} disabled={priceSync.status==="loading"}
              style={{ ...btnStyle(false,"#7dd3fc","#3a6a9a","#1a2a3a"),
                cursor: priceSync.status==="loading" ? "default" : "pointer",
                opacity: priceSync.status==="loading" ? 0.6 : 1 }}>
              {priceSync.status==="loading" ? "⏳ Fetching…" : "🔄 Update Prices"}
            </button>
            <span style={{ fontSize:"11px",
              color: priceSync.status==="error" ? COL.red : priceSync.status==="success" ? COL.accent : COL.muted }}>
              {priceSync.status==="success" && `✓ ${priceSync.message} @ ${new Date(priceSync.syncedAt).toLocaleTimeString()}`}
              {priceSync.status==="error" && `✗ Update failed: ${priceSync.message} (prices unchanged)`}
              {priceSync.status==="idle" && "Not updated yet — click to pull Current GTL prices"}
            </span>
            {liquiditySync.status !== "idle" && (
              <span style={{ fontSize:"10px", color:liquiditySync.status==="loading" ? COL.muted : liquiditySync.status==="error" ? COL.red : "#4a4a6a" }}>
                {liquiditySync.status==="loading" && "⏳ Fetching 1yr liquidity history (~40 requests, can take a bit)…"}
                {liquiditySync.status==="success" && `✓ Liquidity history updated @ ${new Date(liquiditySync.syncedAt).toLocaleTimeString()}`}
                {liquiditySync.status==="error" && "✗ Liquidity history fetch failed"}
              </span>
            )}
          </div>

          {/* Page tabs */}
          <div style={{ display:"flex", gap:"8px", marginBottom:"20px" }}>
            {[["farm","Farm Calc"],["analysis","Price Analysis"]].map(([key,label]) => (
              <button key={key} onClick={() => setPage(key)}
                style={{ background: page===key ? "#0a2a1a" : COL.card,
                  border:`1px solid ${page===key ? "#1a4a2a" : COL.border}`,
                  borderRadius:"6px", color: page===key ? COL.accent : COL.muted,
                  fontWeight: page===key ? "700" : "400",
                  padding:"8px 18px", fontSize:"13px", cursor:"pointer" }}>
                {label}
              </button>
            ))}
          </div>

          {page === "analysis" ? (
            <>
              <RawMaterialsPriceTable ingredientPrices={craftIngredientPrices}
                rawMaterialPriceHistory={rawMaterialPriceHistory} />
              <BpConversionTable bpItemPrices={bpItemPrices} bpItemPriceHistory={bpItemPriceHistory}
                bpItemQuantities={bpItemQuantities} bpItemLiquidity={bpItemLiquidity} />
              <MarketWatchTable marketWatchPrices={marketWatchPrices} marketWatchPriceHistory={marketWatchPriceHistory}
                marketWatchQuantities={marketWatchQuantities} marketWatchLiquidity={marketWatchLiquidity} />
            </>
          ) : (
          <>
          {/* Berry Optimizer */}
          <BerryOptimizer metrics={metrics} seedPrices={seedPrices}
            craftIngredientPrices={craftIngredientPrices} craftItemPrices={craftItemPrices} />

          {/* Seed price editor */}
          {showSeedEditor && (
            <div style={{ background:COL.card, border:"1px solid #1e3a5a", borderRadius:"10px", padding:"18px", marginBottom:"20px" }}>
              <div style={{ fontSize:"11px", color:"#7dd3fc", letterSpacing:"2px", textTransform:"uppercase", marginBottom:"14px" }}>Seed Market Prices</div>
              <SeedPriceEditor seedPrices={seedPrices}
                onChange={(seed, val) => setSeedPrices(p => ({ ...p, [seed]: val }))} />
            </div>
          )}

          {/* Species editor */}
          {showSpeciesEditor && (
            <div style={{ background:COL.card, border:"1px solid #2a1a4a", borderRadius:"10px", padding:"18px", marginBottom:"20px" }}>
              <div style={{ fontSize:"11px", color:COL.purple, letterSpacing:"2px", textTransform:"uppercase", marginBottom:"14px" }}>Species Configuration</div>
              {speciesList.map(sp => (
                <SpeciesEditor key={sp.id} species={sp}
                  onUpdate={updated => setSpeciesList(s => s.map(x => x.id===sp.id ? updated : x))}
                  onRemove={() => setSpeciesList(s => s.filter(x => x.id!==sp.id))} />
              ))}
            </div>
          )}

          {/* ── Berries table ── */}
          <div style={{ background:COL.card, border:`1px solid ${COL.border}`, borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
            <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:"10px", marginBottom:"12px" }}>
              <div>
                <div style={{ fontSize:"11px", color:COL.muted, letterSpacing:"2px", textTransform:"uppercase", marginBottom:"4px" }}>
                  Berries — market price
                </div>
                <div style={{ fontSize:"11px", color:"#4a4a6a" }}>
                  {displayRows.length} berries · ★ is always the actual best (net/day), regardless of sort
                  {hideSparseLiquidity && " · sparse-liquidity berries hidden"}
                  {!showAllBerries && displayRows.length > BERRY_TABLE_COLLAPSED_COUNT &&
                    ` · showing top ${BERRY_TABLE_COLLAPSED_COUNT}`}
                </div>
              </div>
              <div style={{ display:"flex", gap:"8px", flexWrap:"wrap" }}>
                <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"10px", color:COL.muted }}>Show</label>
                  <button onClick={() => setShowAllBerries(v => !v)}
                    style={{
                      background: showAllBerries ? "#0a1a2a" : COL.card,
                      border:`1px solid ${showAllBerries ? "#1a3a5a" : COL.border}`,
                      borderRadius:"6px", color: showAllBerries ? "#7dd3fc" : COL.muted,
                      padding:"7px 10px", fontSize:"11px", cursor:"pointer", whiteSpace:"nowrap" }}>
                    {showAllBerries ? `▲ Top ${BERRY_TABLE_COLLAPSED_COUNT} Only` : `▼ Show All (${displayRows.length})`}
                  </button>
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"10px", color:COL.muted }}>Liquidity</label>
                  <button onClick={() => setHideSparseLiquidity(v => !v)}
                    style={{
                      background: hideSparseLiquidity ? "#2a1414" : COL.card,
                      border:`1px solid ${hideSparseLiquidity ? "#7a3a3a" : COL.border}`,
                      borderRadius:"6px", color: hideSparseLiquidity ? COL.red : COL.muted,
                      padding:"7px 10px", fontSize:"11px", cursor:"pointer", whiteSpace:"nowrap" }}>
                    {hideSparseLiquidity ? "▼ Sparse Hidden" : "Hide Sparse Liquidity"}
                  </button>
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"10px", color:COL.muted }}>Sort by</label>
                  <select value={berrySortBy} onChange={e => setBerrySortBy(e.target.value)}
                    style={{ ...fs, width:"auto", fontSize:"11px", cursor:"pointer" }}>
                    <option value="netPerDay">Net / Day</option>
                    <option value="name">Berry (A–Z)</option>
                    <option value="marketPrice">Market Price</option>
                    <option value="netProfit">Net Profit</option>
                    <option value="margin">Margin</option>
                  </select>
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"10px", color:COL.muted }}>Price used in calcs</label>
                  <select value={pricingMode} onChange={e => setPricingMode(e.target.value)}
                    style={{ ...fs, width:"auto", fontSize:"11px", cursor:"pointer" }}>
                    <option value="auto">Auto (best of NPC/GTL/Trade)</option>
                    <option value="npc">Force NPC (base) price</option>
                    <option value="market">Force market (GTL) price</option>
                  </select>
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"10px", color:COL.muted }}>Seed cost basis</label>
                  <select value={seedCostBasis} onChange={e => setSeedCostBasis(e.target.value)}
                    style={{ ...fs, width:"auto", fontSize:"11px", cursor:"pointer" }}>
                    <option value="gtl">GTL price (full)</option>
                    <option value="fair">Fair trade (−$50/seed, in person)</option>
                  </select>
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:"3px" }}>
                  <label style={{ fontSize:"10px", color:COL.muted }}>Leppa trade discount</label>
                  <div style={{ display:"flex", alignItems:"center", gap:"4px" }}>
                    <button onClick={() => setLeppaTradeDiscount(v => Math.max(0, v - 10))}
                      style={{ background:COL.card, border:`1px solid ${COL.border}`, borderRadius:"4px",
                        color:COL.muted, width:"22px", height:"28px", fontSize:"13px", cursor:"pointer" }}>−</button>
                    <input type="number" step={10} value={leppaTradeDiscount}
                      onChange={e => setLeppaTradeDiscount(Math.max(0, Math.floor(Number(e.target.value) / 10) * 10))}
                      style={{ ...fs, width:"56px", textAlign:"center", fontSize:"11px" }} />
                    <button onClick={() => setLeppaTradeDiscount(v => v + 10)}
                      style={{ background:COL.card, border:`1px solid ${COL.border}`, borderRadius:"4px",
                        color:COL.muted, width:"22px", height:"28px", fontSize:"13px", cursor:"pointer" }}>+</button>
                  </div>
                </div>
              </div>
            </div>
            <BerryTable rows={shownRows} bestId={overallBest?.id} pricingMode={pricingMode} />
          </div>

          {/* ── Optimal allocation ── */}
          {overallBest && (
            <div style={{ background:"#0a1a0a", border:"1px solid #1a4a1a", borderRadius:"10px", padding:"16px", marginBottom:"20px" }}>
              <div style={{ fontSize:"11px", color:COL.accent, letterSpacing:"2px", textTransform:"uppercase", marginBottom:"12px" }}>
                Optimal Allocation — {farmers} Farmer{farmers!==1?"s":""}
              </div>
              <div style={{ fontSize:"13px", color:COL.muted, marginBottom:"14px" }}>
                Best per day: <span style={{ color:COL.accent, fontWeight:"700" }}>{overallBest.name}</span>
                {overallBest.cyclesPerDay > 1 && <span style={{ color:COL.gold }}> · {overallBest.cyclesPerDay}× per day</span>}
                <span style={{ color:"#86efac" }}> · ${fmt(overallBest.effectivePrice)}/berry via {overallBest.sellChannel}</span>
              </div>
              <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:"12px" }}>
                {[
                  { label:"Net / farmer per day",                value:`$${fmt(overallBest.netPerDay)}` },
                  { label:`Total net · ${farmers} farmers / day`, value:`$${fmt(overallBest.netPerDay*farmers)}`, hi:true },
                  { label:"Total seed cost / day",               value:`$${fmt(overallBest.seedCost*overallBest.cyclesPerDay*farmers)}` },
                ].map(({ label, value, hi }) => (
                  <div key={label} style={{ background:"#0d2a0d", borderRadius:"8px", padding:"12px" }}>
                    <div style={{ fontSize:"10px", color:COL.muted, marginBottom:"5px" }}>{label}</div>
                    <div style={{ fontSize:hi?"20px":"16px", fontWeight:"700", color:hi?COL.gold:COL.accent }}>{value}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Seed Cracker */}
          <SeedCracker seedPrices={seedPrices} metrics={metrics} />

          {/* Crafting Calculator */}
          <CraftingCalculator metrics={metrics}
            ingredientPrices={craftIngredientPrices} setIngredientPrices={setCraftIngredientPrices}
            ingredientQuantities={craftIngredientQuantities}
            craftItemPrices={craftItemPrices} setCraftItemPrices={setCraftItemPrices}
            craftItemQuantities={craftItemQuantities} craftLiquidity={craftLiquidity} />
          </>
          )}

        </div>
      </div>
    );
  }

  ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
