        <div style={{ display:"grid", gridTemplateColumns:`repeat(${options.length},1fr)`, gap:"10px" }}>
          {options.map(o => {
            const isRec = o.key === recommended.key;
            return (
              <div key={o.key} style={{ background:isRec ? "#0a1a12" : "#0d0d1f",
                border:`1px solid ${isRec ? "#1a4a2a" : COL.border}`, borderRadius:"8px", padding:"12px" }}>
                <div style={{ fontSize:"11px", color:isRec ? COL.accent : COL.muted, marginBottom:"2px" }}>
                  {isRec ? "★ " : ""}{o.label}
                </div>
                <div style={{ fontSize:"10px", color:"#4a4a6a", marginBottom:"8px" }}>{o.sub}</div>
                <div style={{ fontSize:"18px", fontWeight:"700", color:isRec ? COL.gold : COL.text }}>
                  ${fmt(o.netPerDay)}<span style={{ fontSize:"11px", fontWeight:"400", color:COL.muted }}> /day</span>
